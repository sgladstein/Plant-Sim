+//! Look mockups for the plant-visuals research (not for merge). `PS_MOCK=frame,pose,value`
+//! turns on each experiment.
+
+use std::sync::OnceLock;
+
+fn flags() -> &'static str {
+    static F: OnceLock<String> = OnceLock::new();
+    F.get_or_init(|| std::env::var("PS_MOCK").unwrap_or_default())
+}
+
+/// True if mockup `name` is on.
+pub fn on(name: &str) -> bool {
+    flags().split(',').any(|f| f.trim() == name)
+}
+
+/// A deterministic value in [-1, 1] for (id, salt).
+pub fn hash(id: u32, salt: u32) -> f32 {
+    let mut x = id.wrapping_mul(0x9E37_79B9) ^ salt.wrapping_mul(0x85EB_CA6B);
+    x ^= x >> 16;
+    x = x.wrapping_mul(0x7FEB_352D);
+    x ^= x >> 15;
+    x = x.wrapping_mul(0x846C_A68B);
+    x ^= x >> 16;
+    (x as f32 / u32::MAX as f32) * 2.0 - 1.0
+}
+
+/// Mix `c` toward `to` by `t`.
+pub fn mix(c: [f32; 3], to: [f32; 3], t: f32) -> [f32; 3] {
+    [
+        c[0] + (to[0] - c[0]) * t,
+        c[1] + (to[1] - c[1]) * t,
+        c[2] + (to[2] - c[2]) * t,
+    ]
+}
+
+/// Paper color for the botanical-plate mockup, linear RGB.
+pub const PAPER: [f32; 3] = [0.80, 0.74, 0.60];
