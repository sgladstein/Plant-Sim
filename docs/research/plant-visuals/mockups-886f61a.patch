         let list = instances(&pot.skeleton, options);
+        // Mockup inputs: the oldest leaf's age and the plant's shade-signal range.
+        let mut age_max = 1e-3_f32;
+        let (mut rfr_lo, mut rfr_hi) = (f32::INFINITY, f32::NEG_INFINITY);
+        for (i, p) in pot.skeleton.organs.iter().enumerate() {
+            if p.kind == OrganKind::Leaf && p.alive {
+                age_max = age_max.max(p.thermal_age);
+                if let Some(v) = pot.organ_value(Lens::ShadeSignal, i) {
+                    rfr_lo = rfr_lo.min(v);
+                    rfr_hi = rfr_hi.max(v);
+                }
+            }
+        }
         let mut alive = Vec::with_capacity(list.len());
         for inst in &list {
             alive.push(inst.organ);
             let Some(p) = pot.skeleton.get(inst.organ) else {
                 continue;
             };
-            let (rgb, glow) = organ_color(pot, lens, inst.organ.index(), p);
+            let (mut rgb, glow) = organ_color(pot, lens, inst.organ.index(), p);
+            let id = inst.organ.0;
+            let is_leaf = p.kind == OrganKind::Leaf;
+            if is_leaf && !glow && crate::mock::on("value") {
+                // Canopy depth from the sim's own shade signal: deep leaves darker and
+                // cooler, outer leaves lighter and warmer; plus a small per-leaf offset.
+                let t = pot
+                    .organ_value(Lens::ShadeSignal, inst.organ.index())
+                    .filter(|_| rfr_hi > rfr_lo + 1e-4)
+                    .map_or(0.7, |v| (v - rfr_lo) / (rfr_hi - rfr_lo));
+                let k = 0.5 + 0.62 * t;
+                rgb = rgb.map(|c| c * k);
+                rgb = crate::mock::mix(rgb, [0.02, 0.07, 0.07], 0.25 * (1.0 - t));
+                rgb = crate::mock::mix(rgb, [0.42, 0.50, 0.12], 0.18 * t);
+                let j = 1.0 + 0.07 * crate::mock::hash(id, 7);
+                rgb = [
+                    rgb[0] * j * (1.0 + 0.05 * crate::mock::hash(id, 8)),
+                    rgb[1] * j,
+                    rgb[2] * j,
+                ];
+            }
             let (material, color) = assets.material(&mut materials, rgb, glow);
+            let mut rotation = inst.rotation;
+            if is_leaf && crate::mock::on("pose") {
+                // Age-dependent leaf elevation (render-only stand-in for a sim change):
+                // young leaves stand up, mature ones spread, old ones droop below level.
+                // The sim holds every petiole at 0.5 rad.
+                let a = (p.thermal_age / age_max).clamp(0.0, 1.0);
+                let s = a * a * (3.0 - 2.0 * a);
+                let elevation = 1.15 - 1.5 * s;
+                let pitch = -(elevation - 0.5) + 0.14 * crate::mock::hash(id, 1);
+                let roll = 0.22 * crate::mock::hash(id, 2);
+                let yaw = 0.55 * crate::mock::hash(id, 3);
+                rotation = rotation
+                    * Quat::from_rotation_z(yaw)
+                    * Quat::from_rotation_y(pitch)
+                    * Quat::from_rotation_x(roll);
