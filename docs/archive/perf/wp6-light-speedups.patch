+    /// Inclusive cell-coordinate bounds of cells with nonzero optical depth.
+    #[must_use]
+    pub fn occupied_bounds(&self) -> ([usize; 3], [usize; 3]) {
+        let mut lo = self.n;
+        let mut hi = [0usize; 3];
+        for (i, d) in self.depth.iter().enumerate() {
+            if *d != 0.0 {
+                let c = [
+                    i % self.n[0],
+                    (i / self.n[0]) % self.n[1],
+                    i / (self.n[0] * self.n[1]),
+                ];
+                for a in 0..3 {
+                    lo[a] = lo[a].min(c[a]);
+                    hi[a] = hi[a].max(c[a]);
+                }
+            }
+        }
+        (lo, hi)
+    }
