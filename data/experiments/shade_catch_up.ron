  prompt: "How far behind is a bean in half shade by day 60? Compare dry mass, leaf area and pods.",
  species: "bush_bean",
  variable: Light,
  levels: [100.0, 50.0],
  watch: ["Dry mass by organ", "Leaf area", "Pods"],
)
