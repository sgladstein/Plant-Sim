// Experiment card (design plan §2.5, §6.5). Read by the app's Experiment dialog.
ExperimentCard(
  id: "far_north",
  prompt: "Grow a bean at 60° north. Do the long days make up for the cool, and does shade matter there?",
  species: "bush_bean",
  variable: Light,
  levels: [100.0, 50.0],
  latitude_deg: Some(60.0),
  watch: ["Dry mass by organ", "Height"],
)
