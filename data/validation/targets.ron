// Whole-plant range targets for the bush bean (design plan section 8.2), read from the
// single_pot scenario. Schema: docs/validation-data.md.
ValidationTargets(
  schema: 1,
  species: "bush_bean",
  targets: [
    Target(
      id: "flowering_day",
      scenario: "single_pot",
      variable: "days_since_sowing",
      at: Stage(Flowering),
      expect: Range(min: 28.0, max: 57.0),
      unit: "d",
      basis: None,
      sources: ["ventura1991", "dssat_ccpa9001", "dssat_ufga8501", "cavalcante2020", "pinzon2024"],
      gate: M0,
      note: "First open flower. Warm tropical field 28.7 d (Ventura), Palmira 29 d and Gainesville 32 d (DSSAT anthesis dates), Jaboticabal type I about 42 d (Cavalcante, start of R6, days read from figure labels), cool winter greenhouse 54-57 d (Pinzón, start of R6). A temperate summer should sit in the middle.",
    ),
    Target(
      id: "maturity_day",
      scenario: "single_pot",
      variable: "days_since_sowing",
      at: Stage(Mature),
      expect: Range(min: 54.0, max: 93.0),
      unit: "d",
      basis: None,
      sources: ["ventura1991", "dssat_ccpa9001", "dssat_ufga8501", "cavalcante2020", "pinzon2024", "dssat_ccpo9002", "baldinotti2026"],
      gate: M0,
      note: "Physiological maturity. 54.2 d (Ventura, warm), 60 d (Redkloud, Palmira), 65 d (Seafarer, Gainesville), 73-75 d (Pinzón; Cavalcante type I), 77 d (Redkloud, cool Popayan), 65-93 d across super-early to long-cycle cultivars (Baldinotti, cited by the plan as Conceição 2026).",
    ),
    Target(
      id: "maturity_thermal_time_b10",
      scenario: "single_pot",
      variable: "thermal_time_cd_b10",
      at: Stage(Mature),
      expect: Range(min: 700.0, max: 950.0),
      unit: "Cd",
      basis: Some("mean-method degree-days from sowing, base 10 C"),
      sources: ["cavalcante2020"],
      gate: Info,
      note: "Type I cultivars reach R9 at 826.8 Cd above 10 C in 75 d (Fig. 3 data labels); range -15%/+15%. Info, not a gate: it is one source, and converted to base 10 the other maturity sums sit below it (Pinzón about 680, Dapaah about 500-530), so the gated maturity check is maturity_day.",
    ),
    Target(
      id: "total_dry_mass_at_maturity",
      scenario: "single_pot",
      variable: "total_dry_mass_g",
      at: Stage(Mature),
      expect: Range(min: 12.0, max: 35.0),
      unit: "g",
      basis: None,
      sources: ["kumar2025", "pinzon2024", "mohammed2018"],
      gate: M0,
      note: "Whole plant including roots and shed organs. Kumar 2025 (plan quote, unverified) 21.8 g at harvest; Pinzón 2024 one pot plant in a winter greenhouse about 13.6 g (root 2.4 + shoot 3.1 + pods 8.3 at R8, period 1); Mohammed 2018 17.6 g at 43 days after emergence (field, per-plant basis unclear). A lone pot plant in temperate full sun is expected near the upper half.",
    ),
    Target(
      id: "pods_at_maturity",
      scenario: "single_pot",
      variable: "pods",
      at: Final,
      expect: Range(min: 6.0, max: 20.0),
      unit: "pods",
      basis: None,
      sources: ["kumar2025", "kazai2019", "vargas2021"],
      gate: M0,
      note: "Pods per plant. Kumar 2025 11.8 (plan quote, unverified); Kazai 2019 well-watered field 8.7 (Table 1); Vargas 2021 control 8.2 (Table 1). Field plants at stand density carry fewer (DSSAT Redkloud 4.9, Seafarer 4.5 per plant) than a lone pot plant.",
    ),
    Target(
      id: "max_height",
      scenario: "single_pot",
      variable: "height_m",
      at: Max,
      expect: Range(min: 0.25, max: 0.5),
      unit: "m",
      basis: None,
      sources: ["kumar2025", "dssat_ufga0701", "lopes1987", "kazai2019"],
      gate: M0,
      note: "Kumar 2025 35 cm (unverified); snap bean Bronco canopy 0.33-0.39 m from 50 d on (DSSAT UFGA0701); Negrito 897 39.2 cm in full sun (Lopes 1987); Kazai 2019 51.5 cm (well watered, Table 1).",
    ),
    Target(
      id: "peak_leaf_area",
      scenario: "single_pot",
      variable: "leaf_area_m2",
      at: Max,
      expect: Range(min: 0.07, max: 0.35),
      unit: "m2",
      basis: None,
      sources: ["kumar2025", "dssat_ccpa9001", "dssat_ufga8501", "clavijo2019", "maldonado1993"],
      gate: M0,
      note: "Per plant. Kumar 2025 0.12 m2 (unverified); field plants at 25-52 plants/m2 peak at 0.07-0.11 m2 (DSSAT Seafarer, Redkloud); widely spaced plants (5 plants/m2) exceed 0.3 m2 (Clavijo 2019, text); ICA-Cerinza reaches 0.29 m2 at 78 d after emergence in a cool climate (Maldonado 1993, Table 1). A lone pot plant sits between the dense and the open values.",
    ),
    Target(
      id: "emergence_day",
      scenario: "single_pot",
      variable: "days_since_sowing",
      at: Stage(Emerged),
      expect: Range(min: 4.0, max: 17.0),
      unit: "d",
      basis: None,
      sources: ["ventura1991", "cavalcante2020", "pinzon2024"],
      gate: Info,
      note: "4.5 d warm field (Ventura); about 10 d (Cavalcante, figure labels); 11 and 17 d in the greenhouse (Pinzón, V1).",
    ),
    Target(
      id: "emergence_thermal_time_b10",
      scenario: "single_pot",
      variable: "thermal_time_cd_b10",
      at: Stage(Emerged),
      expect: Approx(value: 92.5, rel_tol: 0.25),
      unit: "Cd",
      basis: Some("mean-method degree-days from sowing, base 10 C"),
      sources: ["cavalcante2020"],
      gate: Info,
      note: "Type I, V1 (emergence), Fig. 3.",
    ),
    Target(
      id: "flowering_thermal_time_b10",
      scenario: "single_pot",
      variable: "thermal_time_cd_b10",
      at: Stage(Flowering),
      expect: Approx(value: 430.3, rel_tol: 0.15),
      unit: "Cd",
      basis: Some("mean-method degree-days from sowing, base 10 C"),
      sources: ["cavalcante2020"],
      gate: Info,
      note: "Type I, reaching R6 (flowering): cumulative of the Fig. 3 stage sums.",
    ),
    Target(
      id: "pod_set_thermal_time_b10",
      scenario: "single_pot",
      variable: "thermal_time_cd_b10",
      at: Stage(PodSet),
      expect: Approx(value: 486.7, rel_tol: 0.15),
      unit: "Cd",
      basis: Some("mean-method degree-days from sowing, base 10 C"),
      sources: ["cavalcante2020"],
      gate: Info,
      note: "Type I, reaching R7 (pod formation).",
    ),
    Target(
      id: "seed_fill_thermal_time_b10",
      scenario: "single_pot",
      variable: "thermal_time_cd_b10",
      at: Stage(SeedFill),
      expect: Approx(value: 569.4, rel_tol: 0.15),
      unit: "Cd",
      basis: Some("mean-method degree-days from sowing, base 10 C"),
      sources: ["cavalcante2020"],
      gate: Info,
      note: "Type I, reaching R8 (pod filling).",
    ),
    Target(
      id: "emergence_thermal_time_b8_3",
      scenario: "single_pot",
      variable: "thermal_time_cd_b8.3",
      at: Stage(Emerged),
      expect: Range(min: 131.0, max: 166.0),
      unit: "Cd",
      basis: Some("mean-method degree-days from sowing, base 8.3 C"),
      sources: ["pinzon2024"],
      gate: Info,
      note: "V1 (emergence) at 145.8 and 150.7 Cd in the two periods; range is the two -10%/+10%.",
    ),
    Target(
      id: "flowering_thermal_time_b8_3",
      scenario: "single_pot",
      variable: "thermal_time_cd_b8.3",
      at: Stage(Flowering),
      expect: Range(min: 544.0, max: 680.0),
      unit: "Cd",
      basis: Some("mean-method degree-days from sowing, base 8.3 C"),
      sources: ["pinzon2024"],
      gate: Info,
      note: "Reaching R6 (flowering) at 604.4 and 618.2 Cd (cumulative of the stage table); range -10%/+10%. Note this is well above the species file's flowering sum.",
    ),
    Target(
      id: "pod_set_thermal_time_b8_3",
      scenario: "single_pot",
      variable: "thermal_time_cd_b8.3",
      at: Stage(PodSet),
      expect: Range(min: 608.0, max: 757.0),
      unit: "Cd",
      basis: Some("mean-method degree-days from sowing, base 8.3 C"),
      sources: ["pinzon2024"],
      gate: Info,
      note: "Reaching R7 at 675.1 and 688.6 Cd.",
    ),
    Target(
      id: "maturity_thermal_time_b8_3",
      scenario: "single_pot",
      variable: "thermal_time_cd_b8.3",
      at: Stage(Mature),
      expect: Range(min: 723.0, max: 889.0),
      unit: "Cd",
      basis: Some("mean-method degree-days from sowing, base 8.3 C"),
      sources: ["pinzon2024"],
      gate: Info,
      note: "Whole cycle 803.5 and 808.6 Cd (the plan's '~800 Cd'); range -10%/+10%.",
    ),
    Target(
      id: "emergence_thermal_time_b7",
      scenario: "single_pot",
      variable: "thermal_time_cd_b7",
      at: Stage(Emerged),
      expect: Range(min: 57.6, max: 110.4),
      unit: "Cd",
      basis: Some("mean-method degree-days from sowing, base 7 C"),
      sources: ["dapaah1999"],
      gate: Info,
      note: "Sowing to emergence across six sowings, Table 2.",
    ),
    Target(
      id: "flowering_thermal_time_b7",
      scenario: "single_pot",
      variable: "thermal_time_cd_b7",
      at: Stage(Flowering),
      expect: Range(min: 338.0, max: 440.0),
      unit: "Cd",
      basis: Some("mean-method degree-days from sowing, base 7 C"),
      sources: ["dapaah1999"],
      gate: Info,
      note: "S-E plus E-F per sowing from Table 2 (lowest 347, highest 424); range widened slightly. Mean 76 + 306 = 382.",
    ),
    Target(
      id: "pod_set_thermal_time_b7",
      scenario: "single_pot",
      variable: "thermal_time_cd_b7",
      at: Stage(PodSet),
      expect: Range(min: 410.0, max: 520.0),
      unit: "Cd",
      basis: Some("mean-method degree-days from sowing, base 7 C"),
      sources: ["dapaah1999"],
      gate: Info,
      note: "Adds F-podding (58-110 Cd); mean 461.",
    ),
    Target(
      id: "maturity_thermal_time_b7",
      scenario: "single_pot",
      variable: "thermal_time_cd_b7",
      at: Stage(Mature),
      expect: Range(min: 760.0, max: 950.0),
      unit: "Cd",
      basis: Some("mean-method degree-days from sowing, base 7 C"),
      sources: ["dapaah1999"],
      gate: Info,
      note: "Adds podding to physiological maturity (369-452 Cd); mean 76 + 306 + 79 + 392 = 853. Othello is a pinto, likely type III.",
    ),
    Target(
      id: "first_trifoliate_thermal_time_b4_4",
      scenario: "single_pot",
      variable: "thermal_time_cd_b4.4",
      at: Stage(FirstTrifoliate),
      expect: Range(min: 263.0, max: 372.0),
      unit: "Cd",
      basis: Some("single-sine degree-days from seeding, 4.44 C lower and 32.2 C upper threshold, converted from F-days by x 5/9"),
      sources: ["croptime2020"],
      gate: Info,
      note: "526-608 F-days across Sahara, 5630 and Provider = 292-338 Cd, widened 10%. The harness sums the mean method without the upper cutoff; the two agree within a few percent in a temperate summer.",
    ),
    Target(
      id: "flowering_thermal_time_b4_4",
      scenario: "single_pot",
      variable: "thermal_time_cd_b4.4",
      at: Stage(Flowering),
      expect: Range(min: 547.0, max: 763.0),
      unit: "Cd",
      basis: Some("single-sine degree-days from seeding, 4.44 C lower and 32.2 C upper threshold, converted from F-days by x 5/9"),
      sources: ["croptime2020"],
      gate: Info,
      note: "First open flowers at 1094-1248 F-days = 608-693 Cd, widened 10%. Temperate snap bush beans in Oregon: the closest climate match to the default scenario.",
    ),
    Target(
      id: "main_nodes_final",
      scenario: "single_pot",
      variable: "main_nodes",
      at: Final,
      expect: Range(min: 5.0, max: 10.0),
      unit: "nodes",
      basis: Some("DSSAT L#SD counts leaves on the main stem including the unifoliate node"),
      sources: ["dssat_ufga8501", "dssat_ccpa9001"],
      gate: Info,
      note: "Type I main stems end at 6.0-9.8 leaves: Redkloud 6, Isabella 6.3, Manitou 7.3, Seafarer 9.3.",
    ),
    Target(
      id: "seeds_per_pod",
      scenario: "single_pot",
      variable: "seeds_per_pod",
      at: Final,
      expect: Range(min: 2.0, max: 5.5),
      unit: "-",
      basis: None,
      sources: ["kumar2025", "kazai2019", "vargas2021", "cropgro_drybean_spe"],
      gate: Info,
      note: "Kumar 3.7 (unverified); Kazai 2.2; Vargas 3.26; DSSAT SDPDV 3.0-5.5 across cultivars.",
    ),
    Target(
      id: "mean_seed_mass",
      scenario: "single_pot",
      variable: "mean_seed_mass_g",
      at: Final,
      expect: Range(min: 0.16, max: 0.6),
      unit: "g",
      basis: None,
      sources: ["dssat_ufga8501", "dssat_ccpa9001", "dssat_ccpo9002", "vargas2021", "kazai2019"],
      gate: Info,
      note: "Seafarer 0.16, Kazai 0.27, Vargas 0.34, Redkloud 0.41-0.56 g per seed.",
    ),
    Target(
      id: "seed_mass_per_plant",
      scenario: "single_pot",
      variable: "seed_mass_g",
      at: Final,
      expect: Range(min: 5.0, max: 20.0),
      unit: "g",
      basis: None,
      sources: ["kumar2025", "vargas2021", "pinzon2024"],
      gate: Info,
      note: "Kumar 8.8 g (unverified); Vargas 9.4 g (control, Table 1); Pinzón pods 8.4 g dry at R8 (pod walls included). Upper bound allows a lone pot plant with 16-20 pods inside the pod and seed-size ranges.",
    ),
    Target(
      id: "root_shoot_seed_fill",
      scenario: "single_pot",
      variable: "root_shoot_ratio",
      at: Stage(SeedFill),
      expect: Range(min: 0.08, max: 0.3),
      unit: "g/g",
      basis: Some("root over living above-ground mass"),
      sources: ["pinzon2024", "acostadiaz2007"],
      gate: Info,
      note: "Pinzón 2024 pot plant at R8: root 2.4 g over shoot 3.1 g + pods 8.3 g = 0.21 (period 1); period 2 gives 1.25 / (1.70 + 5.3) = 0.18. Acosta-Díaz 2007 well-watered pot plants sit in the same band. Literature range for reproductive bean roughly 0.1-0.25.",
    ),
    Target(
      id: "biomass_logistic",
      scenario: "single_pot",
      variable: "total_dry_mass_g",
      at: Final,
      expect: LogisticR2(min_r2: 0.95),
      unit: "-",
      basis: Some("R2 of a three-parameter logistic fitted to the daily total dry mass, sowing to the end of the run"),
      sources: ["pinzon2024"],
      gate: M0,
      note: "M0 exit (plan §7 and §8.3 shape rule): the biomass curve is logistic with R2 above 0.95. Pinzón 2024 fits logistic curves to bush-bean dry mass over the cycle.",
    ),
    Target(
      id: "harvest_index_tops",
      scenario: "single_pot",
      variable: "harvest_index_tops",
      at: Stage(Mature),
      expect: Range(min: 0.4, max: 0.6),
      unit: "g/g",
      basis: Some("DSSAT HIAD: seed over living above-ground mass"),
      sources: ["dssat_ufga8501", "dssat_ccpa9001", "dssat_ccpo9002"],
      gate: Info,
      note: "Measured HIAD at maturity: Isabella 0.48, Manitou 0.46, Seafarer 0.55, Redkloud 0.51-0.58.",
    ),
    Target(
      id: "sla_early",
      scenario: "single_pot",
      variable: "sla_cm2_per_g",
      at: Day(30),
      expect: Range(min: 200.0, max: 400.0),
      unit: "cm2/g",
      basis: None,
      sources: ["desalew2021", "mohammed2018", "dssat_ccpa9001", "dssat_ufga8501"],
      gate: Info,
      note: "199-320 cm2/g at 20-33 d after emergence (Desalew, Table 2); 284-341 at 29-43 d (Mohammed, Table 1); DSSAT field SLAD 280-434 before flowering. The plan's '~240 highest genotype' source (Gebeyehu 2019) could not be found.",
    ),
    Target(
      id: "nar_early",
      scenario: "single_pot",
      variable: "nar_g_m2_day",
      at: Day(40),
      expect: Range(min: 2.0, max: 6.0),
      unit: "g/m2/d",
      basis: None,
      sources: ["mohammed2018"],
      gate: Info,
      note: "Mohammed 2018: 29.5-43.6 mg/dm2/d = 2.9-4.4 g/m2/d between 29 and 43 d after emergence (Table 3). The plan's 'up to 41' matches this paper, not Merga 2021.",
    ),
    Target(
      id: "leaves_at_harvest",
      scenario: "single_pot",
      variable: "leaves",
      at: Max,
      expect: Range(min: 12.0, max: 30.0),
      unit: "leaves",
      basis: None,
      sources: ["kumar2025"],
      gate: Info,
      note: "Kumar 2025: 20 leaves (unverified).",
    ),
    Target(
      id: "branches_at_harvest",
      scenario: "single_pot",
      variable: "branches",
      at: Final,
      expect: Range(min: 3.0, max: 8.0),
      unit: "branches",
      basis: None,
      sources: ["kumar2025"],
      gate: Info,
      note: "Kumar 2025: 5.5 branches (unverified).",
    ),
    Target(
      id: "ndfa_garden_plot",
      scenario: "plot_30_beans",
      variable: "ndfa_season",
      at: Final,
      expect: Range(min: 0.30, max: 0.60),
      unit: "g/g",
      basis: Some("season share of N gain fixed (fixed over fixed plus soil uptake), mean of the 30 plants"),
      sources: ["palmero2022"],
      gate: Info,
      note: "Palmero 2022: bean Ndfa in moderate-N field soil, read as a 30-60% season band (research notes m2-m3-bean-science.md). The 20 ppm garden bed holds about 0.7 g mineral N per plant, close to the whole need, so a low value here is not alarming; the sim gives about 18% at model 0.5.0 (decision 0020 amendment).",
    ),
    Target(
      id: "ndfa_low_n_bed",
      scenario: "m2/plot_low_n",
      variable: "ndfa_season",
      at: Final,
      expect: Range(min: 0.50, max: 0.80),
      unit: "g/g",
      basis: Some("as ndfa_garden_plot, on a 5 ppm nitrate bed"),
      sources: ["palmero2022"],
      gate: Info,
      note: "The low-N case: with little soil nitrate, fixation should carry most of the gain. The band is a guess from the review of WP24 (~), inside the 19.6-88.4% range across 63 bean genotypes (Gunununu 2026, research notes nitrogen_fixation).",
    ),
    Target(
      id: "pole_height_day60",
      scenario: "m2/pole_trellis",
      variable: "height_m",
      at: Day(60),
      expect: Range(min: 1.5, max: 2.1),
      unit: "m",
      basis: Some("staked on a 2 m, 1.5 cm stake; sown 10 June at 45 N (about 20 C mean)"),
      sources: ["research_wp22_height", "gurneys_kentucky_wonder"],
      gate: Info,
      note: "WP22 done-when as the research recommends: at least 1.5 m by day 60 and 2 m by day 75 at a 20 C mean (the plan had 2 m by day 60). About 13.5 main-stem nodes by day 60 need 15 cm internodes. The owner's choice of target is pending (decision 0021).",
    ),
    Target(
      id: "pole_height_final",
      scenario: "m2/pole_trellis",
      variable: "height_m",
      at: Final,
      expect: Range(min: 1.5, max: 2.1),
      unit: "m",
      basis: Some("as pole_height_day60, at the end of the run"),
      sources: ["gurneys_kentucky_wonder"],
      gate: Info,
      note: "Kentucky Wonder vines reach 1.5 to 2.1 m.",
    ),
  ],
)
