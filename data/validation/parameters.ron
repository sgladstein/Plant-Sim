// Published values for species-file parameters (data/species/bush_bean.ron), compared
// with the file's defaults. Schema: docs/validation-data.md.
ParameterChecks(
  schema: 1,
  species: "bush_bean",
  checks: [
    ParamCheck(
      parameter: "vcmax25",
      expect: Range(min: 49.0, max: 155.0),
      unit: "umol/m2/s",
      basis: Some("25 C; Pimentel's basis not stated (likely Ci); Wullschleger Ci basis"),
      sources: ["pimentel2011", "wullschleger1993", "mckenziegopsill2020"],
      gate: Info,
      note: "Pimentel 89.3 (n = 4, Carioca); common-bean range 49-91 in Wullschleger (as quoted by Pimentel); 76.5 rising to 155.4 during vegetative growth in the field (McKenzie-Gopsill). Herbaceous annual mean 75.",
    ),
    ParamCheck(
      parameter: "jmax25",
      expect: Range(min: 96.0, max: 166.0),
      unit: "umol/m2/s",
      basis: Some("25 C"),
      sources: ["pimentel2011", "wullschleger1993"],
      gate: Info,
      note: "Pimentel 159.8; Wullschleger bean range 96-165 (as quoted by Pimentel); annual mean 154.",
    ),
    ParamCheck(
      parameter: "rd25",
      expect: Approx(value: 0.88, rel_tol: 0.5),
      unit: "umol/m2/s",
      basis: Some("day respiration fitted from the A/Ci curve, not a dark measurement"),
      sources: ["pimentel2011"],
      gate: Info,
      note: "No measured mature-leaf dark respiration for bean was found.",
    ),
    ParamCheck(
      parameter: "specific_leaf_area",
      expect: Range(min: 250.0, max: 350.0),
      unit: "cm2/g",
      basis: Some("CROPGRO SLAVR, standard conditions"),
      sources: ["cropgro_drybean_spe"],
      gate: Info,
      note: "SLAVR 305 (Andean Type I), 310 (Meso Type I); 250-350 across cultivars.",
    ),
    ParamCheck(
      parameter: "leaf_area_potential",
      expect: Range(min: 133.0, max: 180.0),
      unit: "cm2",
      basis: Some("largest full trifoliate (CROPGRO SIZLF)"),
      sources: ["cropgro_drybean_spe"],
      gate: Info,
      note: "SIZLF 133-180 cm2.",
    ),
    ParamCheck(
      parameter: "seed_mass",
      expect: Range(min: 0.22, max: 0.66),
      unit: "g",
      basis: Some("maximum seed mass (CROPGRO WTPSD)"),
      sources: ["cropgro_drybean_spe"],
      gate: Info,
      note: "Meso Type I 0.23, Andean Type I 0.60.",
    ),
    ParamCheck(
      parameter: "seeds_per_pod",
      expect: Range(min: 3.0, max: 5.5),
      unit: "-",
      basis: Some("CROPGRO SDPDV"),
      sources: ["cropgro_drybean_spe"],
      gate: Info,
      note: "Andean 3.5, Meso 5.2.",
    ),
    ParamCheck(
      parameter: "flowers_per_raceme",
      expect: Range(min: 3.0, max: 8.0),
      unit: "-",
      basis: None,
      sources: ["santanna_climbers"],
      gate: Info,
      note: "Axillary racemes of 3-8 flowers, occasionally more.",
    ),
    ParamCheck(
      parameter: "pod_set_base",
      expect: Range(min: 0.2, max: 0.55),
      unit: "-",
      basis: Some("fraction of flowers that make a mature pod"),
      sources: ["binnie1981"],
      gate: Info,
      note: "45-80% of flowers and young pods are shed across seven cultivars (inferred set fraction).",
    ),
    ParamCheck(
      parameter: "phyllochron",
      expect: Range(min: 50.0, max: 70.0),
      unit: "Cd",
      basis: Some("base 8 C as in the species file; CROPGRO TRIFL is per thermal day (22 Cd above 5 C)"),
      sources: ["cropgro_drybean_spe"],
      gate: Info,
      note: "TRIFL 0.34 (0.32-0.36) leaves per thermal day = 61-69 Cd per node above 5 C, about 56 above 8 C (inferred conversion).",
    ),
    ParamCheck(
      parameter: "leaf_frost_kill",
      expect: Range(min: -3.5, max: -0.8),
      unit: "C",
      basis: None,
      sources: ["cropgro_drybean_spe", "meyer2001", "gubbels1969"],
      gate: Info,
      note: "CROPGRO FREEZ1 -2.22 (leaf damage), FREEZ2 -5.0 (death); seedling LT50 -3.25 to -3.5 (Meyer); no serious injury above -0.8 (Gubbels).",
    ),
    ParamCheck(
      parameter: "phenology.t_base",
      expect: Range(min: 5.0, max: 10.0),
      unit: "C",
      basis: None,
      sources: ["cropgro_drybean_spe", "dapaah1999", "pinzon2024", "cavalcante2020"],
      gate: Info,
      note: "Bases in use: 5 (CROPGRO), 7 (Dapaah, from a development-rate regression), 8.3 (Pinzón), 10 (Cavalcante).",
    ),
    ParamCheck(
      parameter: "phenology.flowering",
      expect: Range(min: 300.0, max: 600.0),
      unit: "Cd",
      basis: Some("base 8 C from germination, as in the species file"),
      sources: ["pinzon2024", "cavalcante2020", "dapaah1999", "croptime2020"],
      gate: Info,
      note: "Inferred conversions, all done the same way: sum on base X plus (X - 8) x days to the stage, minus about 30 Cd for sowing to germination. Dapaah 382 b7 over about 40 d gives about 310; CROPTIME about 650 b4.4 over about 40 d (days not given, assumed) gives about 475; Cavalcante 430 b10 over about 42 d gives about 485; Pinzón about 610 b8.3 over 54-57 d gives about 565. The default 320 is at the low end.",
    ),
    ParamCheck(
      parameter: "phenology.maturity",
      expect: Range(min: 680.0, max: 980.0),
      unit: "Cd",
      basis: Some("base 8 C from germination, as in the species file"),
      sources: ["pinzon2024", "cavalcante2020", "dapaah1999"],
      gate: Info,
      note: "Inferred conversions as for flowering: Dapaah 853 b7 over about 110-130 d gives about 700; Pinzón 805 b8.3 over 75 d gives about 750; Cavalcante 827 b10 over 75 d gives about 945.",
    ),
  ],
)
