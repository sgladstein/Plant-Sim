// Response targets (design plan section 8.3): each scenario against response/control.
// rel_change = scenario / baseline - 1. Schema: docs/validation-data.md.
ValidationResponses(
  schema: 1,
  species: "bush_bean",
  responses: [
    Response(
      id: "drought_pods",
      scenario: "response/drought_from_flowering",
      baseline: "response/control",
      variable: "pods",
      at: Final,
      expect: RelChange(min: -0.9, max: -0.3),
      sources: ["kazai2019", "gomes2000"],
      gate: M0,
      tag: Emergent,
      note: "M0 exit: pod count down at least 30%. Kazai 2019 -53% (Table 1; cultivars -8% to -95%), Gomes 2000 about -60% (Carioca, text).",
    ),
    Response(
      id: "drought_pods_cited",
      scenario: "response/drought_from_flowering",
      baseline: "response/control",
      variable: "pods",
      at: Final,
      expect: Cited(rel_change: -0.53),
      sources: ["kazai2019"],
      gate: Info,
      tag: Emergent,
      note: "Mean of four cultivars, 8.7 to 4.1 pods per plant.",
    ),
    Response(
      id: "drought_pods_fall_more_than_seed_size",
      scenario: "response/drought_from_flowering",
      baseline: "response/control",
      variable: "pods",
      at: Final,
      expect: FallsMoreThan("mean_seed_mass_g"),
      sources: ["kazai2019", "gomes2000", "rezene2013"],
      gate: M0,
      tag: Emergent,
      note: "M0 exit: seed size down less than pod count. Pods -53% vs 100-seed weight -18% (Kazai); pods -60% vs seed weight unchanged (Gomes).",
    ),
    Response(
      id: "drought_seed_size",
      scenario: "response/drought_from_flowering",
      baseline: "response/control",
      variable: "mean_seed_mass_g",
      at: Final,
      expect: Cited(rel_change: -0.18),
      sources: ["kazai2019", "rezene2013"],
      gate: Info,
      tag: Emergent,
      note: "100-seed weight -18% (Kazai, Table 1), -19% (Rezene, abstract); Gomes found no significant change.",
    ),
    Response(
      id: "drought_seeds_per_pod",
      scenario: "response/drought_from_flowering",
      baseline: "response/control",
      variable: "seeds_per_pod",
      at: Final,
      expect: Cited(rel_change: -0.1),
      sources: ["kazai2019", "rezene2013"],
      gate: Info,
      tag: Emergent,
      note: "-10% (Kazai), -15% (Rezene).",
    ),
    Response(
      id: "drought_seed_yield",
      scenario: "response/drought_from_flowering",
      baseline: "response/control",
      variable: "seed_mass_g",
      at: Final,
      expect: Cited(rel_change: -0.58),
      sources: ["kazai2019", "rezene2013", "gomes2000"],
      gate: Info,
      tag: Emergent,
      note: "-58% (Kazai), -59% (Rezene), about -60% (Gomes, Carioca).",
    ),
    Response(
      id: "drought_root_shoot",
      scenario: "response/drought_from_flowering",
      baseline: "response/control",
      variable: "root_shoot_ratio",
      at: Stage(SeedFill),
      expect: Increase,
      sources: ["acostadiaz2007", "sofi2018"],
      gate: M0,
      tag: PartlyEncoded,
      note: "M0 exit: root to shoot ratio higher. Read at seed fill, before leaf drop shrinks the living shoot.",
    ),
    Response(
      id: "drought_root_shoot_cited",
      scenario: "response/drought_from_flowering",
      baseline: "response/control",
      variable: "root_shoot_ratio",
      at: Stage(SeedFill),
      expect: Cited(rel_change: 0.42),
      sources: ["acostadiaz2007", "sofi2018"],
      gate: Info,
      tag: PartlyEncoded,
      note: "+42% (Acosta-Díaz, shoot -26%, root -44%), +70% (Sofi).",
    ),
    Response(
      id: "drought_shoot_mass",
      scenario: "response/drought_from_flowering",
      baseline: "response/control",
      variable: "shoot_mass_g",
      at: Final,
      expect: Cited(rel_change: -0.26),
      sources: ["acostadiaz2007", "gomes2000"],
      gate: Info,
      tag: Emergent,
      note: "Shoot dry weight -26% (Acosta-Díaz); reduced in all cultivars (Gomes).",
    ),
    Response(
      id: "drought_leaf_area",
      scenario: "response/drought_from_flowering",
      baseline: "response/control",
      variable: "leaf_area_m2",
      at: Max,
      expect: Decrease,
      sources: ["gomes2000"],
      gate: Info,
      tag: Emergent,
      note: "LAI reduced in all cultivars (Gomes, figure only). No measured percentage found; the plan's 'leaf area falls more than other variables' is not yet backed by a number.",
    ),
    Response(
      id: "heat_pods",
      scenario: "response/heat_at_flowering",
      baseline: "response/control",
      variable: "pods",
      at: Final,
      expect: Decrease,
      sources: ["sharda2026", "silva2020", "vargas2021"],
      gate: Info,
      tag: Encoded,
      note: "Info, not a gate: the literature is split. Filled pods fall more in sensitive accessions (Sharda, figure); pods -26% at 37/26 C (Silva). Hot nights in the field can raise pod count while the pods stay empty (Vargas 2021, +54%), so the gated check for the M0 exit 'pod set falls' is heat_seeds.",
    ),
    Response(
      id: "heat_seeds",
      scenario: "response/heat_at_flowering",
      baseline: "response/control",
      variable: "seeds",
      at: Final,
      expect: Decrease,
      sources: ["vargas2021", "sharda2026"],
      gate: M0,
      tag: Encoded,
      note: "Seeds per plant -13% (hot nights) and -20% (hot days) (Vargas, Table 1).",
    ),
    Response(
      id: "heat_seed_mass",
      scenario: "response/heat_at_flowering",
      baseline: "response/control",
      variable: "seed_mass_g",
      at: Final,
      expect: RelChange(min: -0.71, max: -0.5),
      sources: ["sharda2026"],
      gate: Info,
      tag: Encoded,
      note: "Total seed weight -50% (tolerant) to -71% (sensitive) after 7 days at 32/22 C over flowering to podding, the closest regime to the scenario's 32/20 C for 6 days.",
    ),
    Response(
      id: "heat_seed_size",
      scenario: "response/heat_at_flowering",
      baseline: "response/control",
      variable: "mean_seed_mass_g",
      at: Final,
      expect: RelChange(min: -0.34, max: -0.08),
      sources: ["sharda2026"],
      gate: Info,
      tag: Emergent,
      note: "Single seed weight -8% (tolerant) to -34% (sensitive).",
    ),
    Response(
      id: "heat_seeds_per_pod",
      scenario: "response/heat_at_flowering",
      baseline: "response/control",
      variable: "seeds_per_pod",
      at: Final,
      expect: Cited(rel_change: -0.27),
      sources: ["vargas2021"],
      gate: Info,
      tag: Emergent,
      note: "-41% with hot nights, -27% with hot days (Table 1); the scenario raises day and night temperature.",
    ),
    Response(
      id: "shade_total_mass",
      scenario: "response/shade_50",
      baseline: "response/control",
      variable: "total_dry_mass_g",
      at: Final,
      expect: RelChange(min: -0.5, max: -0.3),
      sources: ["cossu2021"],
      gate: M0,
      tag: Emergent,
      note: "M0 exit: total mass 30-50% lower. Total dry mass -33% to -52% under 45% less PAR (Cossu 2021, Fig. 5A).",
    ),
    Response(
      id: "shade_internode",
      scenario: "response/shade_50",
      baseline: "response/control",
      variable: "mean_internode_cm",
      at: Final,
      expect: RelChange(min: 0.2, max: 3.0),
      sources: ["lopes1987", "hanyu1996"],
      gate: M0,
      tag: Encoded,
      note: "M0 exit: internodes at least 20% longer. Height +99% at 62% light with leaf number unchanged (Lopes 1987), so internodes about doubled; the bush type lengthens through internodes only (Hanyu 1996).",
    ),
    Response(
      id: "shade_sla",
      scenario: "response/shade_50",
      baseline: "response/control",
      variable: "sla_cm2_per_g",
      at: Day(40),
      expect: RelChange(min: 0.1, max: 0.4),
      sources: ["cossu2021"],
      gate: M0,
      tag: Encoded,
      note: "M0 exit: specific leaf area higher. Up to +32% (cycle 1) and +15% (cycle 3), Cossu 2021 Fig. 5D.",
    ),
    Response(
      id: "shade_height",
      scenario: "response/shade_50",
      baseline: "response/control",
      variable: "height_m",
      at: Max,
      expect: Cited(rel_change: 0.99),
      sources: ["lopes1987"],
      gate: Info,
      tag: Encoded,
      note: "39.2 to 78.0 cm at 62% light; a stronger shade gives more (+159% at 30%).",
    ),
    Response(
      id: "shade_main_nodes",
      scenario: "response/shade_50",
      baseline: "response/control",
      variable: "main_nodes",
      at: Final,
      expect: RelChange(min: -0.15, max: 0.15),
      sources: ["hanyu1996", "lopes1987"],
      gate: Info,
      tag: Encoded,
      note: "Node and leaf number unchanged in the bush type.",
    ),
    Response(
      id: "shade_pods",
      scenario: "response/shade_50",
      baseline: "response/control",
      variable: "pods",
      at: Final,
      expect: Cited(rel_change: -0.35),
      sources: ["cossu2021"],
      gate: Info,
      tag: Emergent,
      note: "Pod number -35% (Fig. 6B).",
    ),
    Response(
      id: "shade_root_mass",
      scenario: "response/shade_50",
      baseline: "response/control",
      variable: "root_mass_g",
      at: Max,
      expect: Cited(rel_change: -0.3),
      sources: ["lopes1987"],
      gate: Info,
      tag: Emergent,
      note: "Maximum root dry weight -30% at 62% light, -50% at 30%.",
    ),
    Response(
      id: "density_leaf_area_per_plant",
      scenario: "m2/density_35",
      baseline: "m2/density_5",
      variable: "leaf_area_m2",
      at: Max,
      expect: Cited(rel_change: -0.7),
      sources: ["clavijo2019"],
      gate: Info,
      tag: Emergent,
      note: "Baseline m2/density_5. Leaf area per plant above 0.3 m2 at 5 plants/m2 and below 0.1 m2 at 35 (text). Info from WP21, when the plot scenarios were written; the M2 exit gate (decision 0019). The -43% at model 0.4.0 is mostly topsoil nitrogen running out at 35 per m2 (light alone gives -25%, non-limiting N -31%), not the branching and leaf-size response the field shows (decision 0020).",
    ),
    Response(
      id: "nfree_nodulation_shoot_mass",
      scenario: "m2/nfree_nodulated",
      baseline: "m2/nfree_unnodulated",
      variable: "shoot_mass_g",
      at: Day(57),
      expect: RelChange(min: 2.0, max: 100.0),
      sources: ["plan_wp24_nfree"],
      gate: Info,
      tag: Emergent,
      note: "WP24 done-when: in nitrogen-free sand the nodulated shoot is more than 3 times the unnodulated one 45 days after emergence (day 12). The cargo test nitrogen_free_sand_needs_nodules enforces it, with unnodulated plant N at or below seed N (decision 0020).",
    ),
    Response(
      id: "pole_unstaked_seed_yield",
      scenario: "m2/pole_row_no_trellis",
      baseline: "m2/pole_row_trellis",
      variable: "seed_mass_g",
      at: Final,
      expect: RelChange(min: -0.7, max: -0.3),
      sources: ["iita_propas_staking", "reckling2011"],
      gate: Info,
      tag: Emergent,
      note: "WP22 done-when: without a support the vine falls over and yields less; staked against unstaked climbing beans, -30 to -70% (a direction-plus-band check), measured on a row because the field trials are rows. In the sim most of the loss is pods on the soil rotting (pod_rot_rate, encoded), the rest the fallen canopy. The cargo test staked_pole_beans_climb_and_unstaked_ones_lodge enforces it (decision 0021).",
    ),
  ],
)
