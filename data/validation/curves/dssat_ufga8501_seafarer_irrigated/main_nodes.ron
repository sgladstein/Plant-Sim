// Measured main_nodes against days after sowing; DSSAT Drybean experiment UFGA8501.
Curve(
  schema: 1,
  id: "dssat_ufga8501_seafarer_irrigated_main_nodes",
  source: "dssat_ufga8501",
  conditions: "Gainesville FL, 1985; Seafarer (Mesoamerican Type I, navy); field, sandy soil, 51.7 plants/m2, rows 38 cm, irrigated (treatment 5, 100 mm); planted 1985-07-01",
  x: Axis(variable: "days_since_sowing", unit: "d"),
  y: Axis(variable: "main_nodes", unit: "nodes"),
  basis: Some("Days after planting; planting date taken as sowing day 0. Field crop at stand density, so per-plant values are smaller than for a lone pot plant; compare shape and timing, not absolute size. Per-plant values = kg/ha / 10 / plants per m2."),
  method: "Measured time series, DSSAT UFGA8501 .BNT/.GBT file, column L#SD (leaf number on the main stem; DSSAT counts the unifoliate node); read from the file",
  gate: Info,
  points: [
