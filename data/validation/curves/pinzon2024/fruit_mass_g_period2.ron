// Pinzón-Sandoval 2024, fruit_mass_g, period 2: points evaluated from the paper's logistic fit.
Curve(
  schema: 1,
  id: "pinzon2024_fruit_mass_g_period2",
  source: "pinzon2024",
  conditions: "Greenhouse pot plant, BRSMG Marte, period 2 (July-September 2023)",
