  y: Axis(variable: "fruit_mass_g", unit: "g/plant"),
  basis: Some("x: mean-method degree-days from sowing, base 8.3 C. Shoot means leaf + stem (the paper does not separate them)."),
  method: "Evaluated from the published logistic fit Y = a/(1+exp(-b(x-c))) in Table 3 (a 5.76, b 0.1117, c 786.5; R2 0.9), every 50 Cd and at R8; not measured points (the weekly data are in Fig. 4 only)",
  gate: Info,
  points: [
