// Pinzón-Sandoval 2024, fruit_mass_g, period 1: points evaluated from the paper's logistic fit.
Curve(
  schema: 1,
  id: "pinzon2024_fruit_mass_g_period1",
  source: "pinzon2024",
  conditions: "Greenhouse pot plant, BRSMG Marte, period 1 (April-June 2023)",
  x: Axis(variable: "thermal_time_cd_b8.3", unit: "Cd"),
  y: Axis(variable: "fruit_mass_g", unit: "g/plant"),
  basis: Some("x: mean-method degree-days from sowing, base 8.3 C. Shoot means leaf + stem (the paper does not separate them)."),
  method: "Evaluated from the published logistic fit Y = a/(1+exp(-b(x-c))) in Table 2 (a 8.8839, b 0.03952, c 734.42; R2 0.9), every 50 Cd and at R8; not measured points (the weekly data are in Fig. 4 only)",
  gate: Info,
  points: [
    Point(x: 100.0, y: 0.0, sd: None),
