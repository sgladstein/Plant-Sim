// Challenge "Thirsty summer" (data/challenges/thirsty_summer.ron): one bush bean in a
// 24 cm loam pot under a rain shelter, no automatic watering, temperate summer at 45 N.
// The pot starts at field capacity; every drop after that comes from the player's can.
Scenario(
  schema: 1,
  model_version: "0.26.0",
  world_seed: 7,
  latitude_deg: 45.0,
  start: (year: 2026, month: 5, day: 15, hour: 0),
  weather: Preset("temperate_summer"),
  soils: [ Pot(id: 0, diameter_cm: 24.0, depth_cm: 24.0, texture: Loam, position_m: (0.0, 0.0)) ],
  rain_fraction: { 0: 0.0 },
  irrigation: { 0: None },
  nitrogen: { 0: (no3_ppm: 300.0, nh4_ppm: 2.0, organic_g_per_kg: 1.0, rhizobia: true) },
  co2_ppm: 420.0,
  sowings: [ (soil: 0, species: "bush_bean", seed: Default, depth_cm: 3.0) ],
  duration_days: 90,
)
