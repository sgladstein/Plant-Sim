// Challenge "Hungry soil" (data/challenges/hungry_soil.ron): one bush bean in a 24 cm
// pot of worn-out loam (5 ppm nitrate, little organic matter, no rhizobia), watered to
// field capacity every morning, temperate summer at 45 N. Nitrogen comes from the
// player's fertilizer budget.
Scenario(
  schema: 1,
  model_version: "0.24.0",
  world_seed: 7,
  latitude_deg: 45.0,
  start: (year: 2026, month: 5, day: 15, hour: 0),
  weather: Preset("temperate_summer"),
  soils: [ Pot(id: 0, diameter_cm: 24.0, depth_cm: 24.0, texture: Loam, position_m: (0.0, 0.0)) ],
  irrigation: { 0: ToFieldCapacity(every_days: 1) },
  nitrogen: { 0: (no3_ppm: 5.0, nh4_ppm: 1.0, organic_g_per_kg: 0.5, rhizobia: false) },
  co2_ppm: 420.0,
  sowings: [ (soil: 0, species: "bush_bean", seed: Default, depth_cm: 3.0) ],
  duration_days: 90,
)
