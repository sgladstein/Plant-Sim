// R2b split pot (decision 0043): one bush bean in a 24 cm loam pot with a watertight
// divider across its center, north to south, under a rain shelter. Both halves are
// watered to field capacity every morning until day 20 (tick 480); from then only the
// west half is, and the east half dries. The roots should forage in the wet half:
// root length west of the divider at least 1.5 times that east of it by day 45.
Scenario(
  schema: 1,
  model_version: "0.28.0",
  world_seed: 7,
  latitude_deg: 45.0,
  start: (year: 2026, month: 5, day: 15, hour: 0),
  weather: Preset("temperate_summer"),
  soils: [ Pot(id: 0, diameter_cm: 24.0, depth_cm: 24.0, texture: Loam, position_m: (0.0, 0.0)) ],
  rain_fraction: { 0: 0.0 },
  irrigation: { 0: ToFieldCapacity(every_days: 1) },
  dividers: [0],
  // Non-limiting nitrogen, as in single_pot (decision 0020).
  nitrogen: { 0: (no3_ppm: 300.0, nh4_ppm: 2.0, organic_g_per_kg: 1.0, rhizobia: true) },
  co2_ppm: 420.0,
  sowings: [ (soil: 0, species: "bush_bean", seed: Default, depth_cm: 3.0) ],
  // Sown exactly at the center, as an experimenter places the plant.
  variation: (sowing_position_sd_cm: 0.0),
  duration_days: 45,
  events: [
    (tick: 480, kind: SetIrrigation(soil: 0, irrigation: ToFieldCapacityStrip(every_days: 1, east_cm: (-100.0, 0.0)))),
  ],
)
