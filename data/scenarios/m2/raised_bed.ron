// R5c raised bed (decision 0049): m2/plough_pan_control with its top 30 cm loose, at 0.85
// times the loam's bulk density (1.1 Mg m-3), as a raised bed filled with loose soil and
// never walked on keeps it. Against m2/compacted_plot its roots should go deeper.
Scenario(
  schema: 1,
  model_version: "0.30.0",
  world_seed: 7,
  latitude_deg: 45.0,
  start: (year: 2026, month: 5, day: 15, hour: 0),
  weather: Preset("temperate_summer"),
  soils: [ Plot(id: 0, width_cm: 100.0, length_cm: 100.0, depth_cm: 60.0, texture: Loam, position_m: (0.0, 0.0)) ],
  irrigation: { 0: Schedule(every_days: 2, mm: 6.0) },
  density_zones: [ (zone: (soil: 0, depth_cm: (0.0, 30.0)), factor: 0.85) ],
  co2_ppm: 420.0,
  sowings: [ (soil: 0, species: "bush_bean", seed: Default, depth_cm: 3.0, offset_cm: Some((0.0, 0.0))) ],
  variation: (sowing_position_sd_cm: 0.0),
  duration_days: 70,
)
