// The 30-bean plot (plot_30_beans) on a low-nitrogen bed: 5 ppm nitrate instead of the
// garden default 20, the same ammonium (2 ppm) and humus (1 g N per kg), rhizobia present.
// The soil Palmero 2022's 30 to 60% Ndfa band describes is moderate-N field soil; at 5 ppm
// the soil covers little of a stand's need, so fixation should carry most of it (Ndfa
// 50 to 80%, review of WP24). Weather, water and spacing as plot_30_beans.
Scenario(
  schema: 1,
  model_version: "0.5.0",
  world_seed: 7,
  latitude_deg: 45.0,
  start: (year: 2026, month: 5, day: 15, hour: 0),
  weather: Preset("temperate_summer"),
  soils: [ Plot(id: 0, width_cm: 150.0, length_cm: 120.0, depth_cm: 40.0, texture: Loam, position_m: (0.0, 0.0)) ],
  irrigation: { 0: ToFieldCapacity(every_days: 1) },
  nitrogen: { 0: (no3_ppm: 5.0, nh4_ppm: 2.0, organic_g_per_kg: 1.0, rhizobia: true) },
  co2_ppm: 420.0,
  sowings: [
    (soil: 0, species: "bush_bean", seed: Default, depth_cm: 3.0, offset_cm: Some((-62.5, -48.0))),
    (soil: 0, species: "bush_bean", seed: Default, depth_cm: 3.0, offset_cm: Some((-37.5, -48.0))),
