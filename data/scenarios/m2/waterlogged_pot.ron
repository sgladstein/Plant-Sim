// R5b waterlogged pot (decision 0048): one bush bean in a 24 cm loam pot with its holes
// sealed, under a rain shelter, watered to field capacity each morning until it
// flowers. On day 45 it is soaked (30 mm at 06:00 and again at 09:00, past saturation,
// so water stands on the soil) and topped up with 10 mm each morning to day 48. At the
// start of day 49 its holes are opened and it is watered to field capacity again, which
// adds nothing until the pot is below it. The baseline is m2/waterlogged_pot_control.
Scenario(
  schema: 1,
  model_version: "0.31.0",
  world_seed: 7,
  latitude_deg: 45.0,
  start: (year: 2026, month: 5, day: 15, hour: 0),
  weather: Preset("temperate_summer"),
  soils: [ Pot(id: 0, diameter_cm: 24.0, depth_cm: 24.0, texture: Loam, position_m: (0.0, 0.0), drainage: NoHoles) ],
  rain_fraction: { 0: 0.0 },
  irrigation: { 0: ToFieldCapacity(every_days: 1) },
  nitrogen: { 0: (no3_ppm: 300.0, nh4_ppm: 2.0, organic_g_per_kg: 1.0, rhizobia: true) },
  co2_ppm: 420.0,
  sowings: [ (soil: 0, species: "bush_bean", seed: Default, depth_cm: 3.0) ],
  duration_days: 75,
  events: [
    (tick: 1080, kind: SetIrrigation(soil: 0, irrigation: None)),
    (tick: 1086, kind: Water(soil: 0, mm: 30.0)),
    (tick: 1089, kind: Water(soil: 0, mm: 30.0)),
    (tick: 1110, kind: Water(soil: 0, mm: 10.0)),
    (tick: 1134, kind: Water(soil: 0, mm: 10.0)),
    (tick: 1158, kind: Water(soil: 0, mm: 10.0)),
    (tick: 1176, kind: SetDrainage(soil: 0, drainage: Holes)),
    (tick: 1176, kind: SetIrrigation(soil: 0, irrigation: ToFieldCapacity(every_days: 1))),
  ],
)
