// Low density: 4 x 4 bush beans 45 cm apart on a 1.8 x 1.8 m loam plot
// (4.9 plants per m2), 40 cm deep, watered to field capacity every morning, under
// the temperate-summer preset at 45 N. For the density check in data/validation
// (Clavijo 2019: leaf area per plant falls about 70% from 5 to 35 plants per m2).
Scenario(
  schema: 1,
  model_version: "0.19.0",
  world_seed: 7,
  latitude_deg: 45.0,
  start: (year: 2026, month: 5, day: 15, hour: 0),
  weather: Preset("temperate_summer"),
  soils: [ Plot(id: 0, width_cm: 180.0, length_cm: 180.0, depth_cm: 40.0, texture: Loam, position_m: (0.0, 0.0)) ],
  irrigation: { 0: ToFieldCapacity(every_days: 1) },
  co2_ppm: 420.0,
  sowings: [
    (soil: 0, species: "bush_bean", seed: Default, depth_cm: 3.0, offset_cm: Some((-67.5, -67.5))),
    (soil: 0, species: "bush_bean", seed: Default, depth_cm: 3.0, offset_cm: Some((-22.5, -67.5))),
    (soil: 0, species: "bush_bean", seed: Default, depth_cm: 3.0, offset_cm: Some((22.5, -67.5))),
    (soil: 0, species: "bush_bean", seed: Default, depth_cm: 3.0, offset_cm: Some((67.5, -67.5))),
    (soil: 0, species: "bush_bean", seed: Default, depth_cm: 3.0, offset_cm: Some((-67.5, -22.5))),
    (soil: 0, species: "bush_bean", seed: Default, depth_cm: 3.0, offset_cm: Some((-22.5, -22.5))),
    (soil: 0, species: "bush_bean", seed: Default, depth_cm: 3.0, offset_cm: Some((22.5, -22.5))),
    (soil: 0, species: "bush_bean", seed: Default, depth_cm: 3.0, offset_cm: Some((67.5, -22.5))),
    (soil: 0, species: "bush_bean", seed: Default, depth_cm: 3.0, offset_cm: Some((-67.5, 22.5))),
    (soil: 0, species: "bush_bean", seed: Default, depth_cm: 3.0, offset_cm: Some((-22.5, 22.5))),
    (soil: 0, species: "bush_bean", seed: Default, depth_cm: 3.0, offset_cm: Some((22.5, 22.5))),
    (soil: 0, species: "bush_bean", seed: Default, depth_cm: 3.0, offset_cm: Some((67.5, 22.5))),
    (soil: 0, species: "bush_bean", seed: Default, depth_cm: 3.0, offset_cm: Some((-67.5, 67.5))),
    (soil: 0, species: "bush_bean", seed: Default, depth_cm: 3.0, offset_cm: Some((-22.5, 67.5))),
    (soil: 0, species: "bush_bean", seed: Default, depth_cm: 3.0, offset_cm: Some((22.5, 67.5))),
    (soil: 0, species: "bush_bean", seed: Default, depth_cm: 3.0, offset_cm: Some((67.5, 67.5))),
  ],
  duration_days: 90,
)
