// R2b nitrate patch control (decision 0043): m2/nitrate_patch with the cube at the
// soil's own nitrate (factor 1), so the patch variable reads the same cells.
Scenario(
  schema: 1,
  model_version: "0.28.0",
  world_seed: 7,
  latitude_deg: 45.0,
  start: (year: 2026, month: 5, day: 15, hour: 0),
  weather: Preset("temperate_summer"),
  soils: [ Pot(id: 0, diameter_cm: 24.0, depth_cm: 24.0, texture: Loam, position_m: (0.0, 0.0)) ],
  rain_fraction: { 0: 0.0 },
  irrigation: { 0: ToFieldCapacity(every_days: 1) },
  nitrate_patches: [ (soil: 0, center_cm: (0.0, 0.0, 10.0), size_cm: 8.0, no3_factor: 1.0) ],
  co2_ppm: 420.0,
  sowings: [ (soil: 0, species: "bush_bean", seed: Default, depth_cm: 3.0) ],
  // Sown exactly at the center, as an experimenter places the plant.
  variation: (sowing_position_sd_cm: 0.0),
  duration_days: 45,
)
