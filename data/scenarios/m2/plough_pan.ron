// R5c plough pan (decision 0049): one bush bean in the middle of a 1 x 1 m loam plot,
// 60 cm deep, with a compacted layer from 15 to 20 cm at 1.2 times the loam's bulk
// density (1.56 Mg m-3, a plough pan), watered 6 mm every other morning on top of the
// temperate-summer preset's rain. Against m2/plough_pan_control (no pan) its roots should
// be fewer and thicker in and below the pan and more above it.
Scenario(
  schema: 1,
  model_version: "0.30.0",
  world_seed: 7,
  latitude_deg: 45.0,
  start: (year: 2026, month: 5, day: 15, hour: 0),
  weather: Preset("temperate_summer"),
  soils: [ Plot(id: 0, width_cm: 100.0, length_cm: 100.0, depth_cm: 60.0, texture: Loam, position_m: (0.0, 0.0)) ],
  irrigation: { 0: Schedule(every_days: 2, mm: 6.0) },
  density_zones: [ (zone: (soil: 0, depth_cm: (15.0, 20.0)), factor: 1.2) ],
  co2_ppm: 420.0,
  sowings: [ (soil: 0, species: "bush_bean", seed: Default, depth_cm: 3.0, offset_cm: Some((0.0, 0.0))) ],
  variation: (sowing_position_sd_cm: 0.0),
  duration_days: 70,
)
