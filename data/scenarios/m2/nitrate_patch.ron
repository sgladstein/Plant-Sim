// R2b nitrate patch (decision 0043): one bush bean in a 24 cm loam pot of garden soil
// (20 mg nitrate N per kg) under a rain shelter, watered to field capacity every
// morning, with an 8 cm cube of soil on the tap root's path, 6 to 14 cm deep, holding
// ten times the nitrate (as the experiments run the primary root through the patch).
// Laterals should proliferate there: lateral and fine-root length in the cube at least
// 1.5 times that in the same cube of m2/nitrate_patch_control by day 45 (Zhang 1999,
// Linkohr 2002: 1.5 to 4).
Scenario(
  schema: 1,
  model_version: "0.29.0",
  world_seed: 7,
  latitude_deg: 45.0,
  start: (year: 2026, month: 5, day: 15, hour: 0),
  weather: Preset("temperate_summer"),
  soils: [ Pot(id: 0, diameter_cm: 24.0, depth_cm: 24.0, texture: Loam, position_m: (0.0, 0.0)) ],
  rain_fraction: { 0: 0.0 },
  irrigation: { 0: ToFieldCapacity(every_days: 1) },
  nitrate_patches: [ (soil: 0, center_cm: (0.0, 0.0, 10.0), size_cm: 8.0, no3_factor: 10.0) ],
  co2_ppm: 420.0,
  sowings: [ (soil: 0, species: "bush_bean", seed: Default, depth_cm: 3.0) ],
  // Sown exactly at the center, as an experimenter places the plant.
  variation: (sowing_position_sd_cm: 0.0),
  duration_days: 45,
)
