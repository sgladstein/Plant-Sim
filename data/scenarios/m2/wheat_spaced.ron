// WP23 (design plan §7, decision 0022): spaced spring wheat, one plant in each of 4
// replicate 40 cm loam pots 3 m apart. Sown 10 April at 45 N, watered to field capacity
// every morning, non-limiting nitrogen (300 ppm NO3, decision 0020).
Scenario(
  schema: 1,
  model_version: "0.22.0",
  world_seed: 7,
  latitude_deg: 45.0,
  start: (year: 2026, month: 4, day: 10, hour: 0),
  weather: Preset("temperate_summer"),
  soils: [
    Pot(id: 0, diameter_cm: 40.0, depth_cm: 40.0, texture: Loam, position_m: (0.0, 0.0)),
    Pot(id: 1, diameter_cm: 40.0, depth_cm: 40.0, texture: Loam, position_m: (3.0, 0.0)),
    Pot(id: 2, diameter_cm: 40.0, depth_cm: 40.0, texture: Loam, position_m: (6.0, 0.0)),
    Pot(id: 3, diameter_cm: 40.0, depth_cm: 40.0, texture: Loam, position_m: (9.0, 0.0)),
  ],
  irrigation: { 0: ToFieldCapacity(every_days: 1), 1: ToFieldCapacity(every_days: 1), 2: ToFieldCapacity(every_days: 1), 3: ToFieldCapacity(every_days: 1) },
  nitrogen: { 0: (no3_ppm: 300.0, nh4_ppm: 2.0, organic_g_per_kg: 1.0, rhizobia: false), 1: (no3_ppm: 300.0, nh4_ppm: 2.0, organic_g_per_kg: 1.0, rhizobia: false), 2: (no3_ppm: 300.0, nh4_ppm: 2.0, organic_g_per_kg: 1.0, rhizobia: false), 3: (no3_ppm: 300.0, nh4_ppm: 2.0, organic_g_per_kg: 1.0, rhizobia: false) },
  co2_ppm: 420.0,
  sowings: [
    (soil: 0, species: "spring_wheat", seed: Default, depth_cm: 3.0),
    (soil: 1, species: "spring_wheat", seed: Default, depth_cm: 3.0),
    (soil: 2, species: "spring_wheat", seed: Default, depth_cm: 3.0),
    (soil: 3, species: "spring_wheat", seed: Default, depth_cm: 3.0),
  ],
  duration_days: 140,
)
