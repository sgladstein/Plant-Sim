// Response scenarios (design plan §8.3), heat at flowering: six days at 32 °C maximum and
// 20 °C minimum from the control's flowering day (day 33), bright and dry; the pot is
// still watered daily.
Scenario(
  schema: 1,
  model_version: "0.1.0",
  world_seed: 7,
  latitude_deg: 45.0,
  start: (year: 2026, month: 5, day: 15, hour: 0),
  weather: Preset("temperate_summer"),
  soils: [ Pot(id: 0, diameter_cm: 24.0, depth_cm: 24.0, texture: Loam, position_m: (0.0, 0.0)) ],
  irrigation: { 0: ToFieldCapacity(every_days: 1) },
  co2_ppm: 420.0,
  sowings: [ (soil: 0, species: "bush_bean", seed: Default, depth_cm: 3.0) ],
  duration_days: 90,
  heat_wave: Some((start_day: 33, days: 6, t_max_c: 32.0, t_min_c: 20.0)),
)
