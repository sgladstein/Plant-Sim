// Response scenarios (design plan §8.3), drought from flowering: watering stops on the
// control's flowering day (day 33 = tick 792) and the pot dries down. Rain still falls.
Scenario(
  schema: 1,
  model_version: "0.1.0",
  world_seed: 7,
  latitude_deg: 45.0,
  start: (year: 2026, month: 5, day: 15, hour: 0),
  weather: Preset("temperate_summer"),
  soils: [ Pot(id: 0, diameter_cm: 24.0, depth_cm: 24.0, texture: Loam, position_m: (0.0, 0.0)) ],
  irrigation: { 0: ToFieldCapacity(every_days: 1) },
  co2_ppm: 420.0,
  sowings: [ (soil: 0, species: "bush_bean", seed: Default, depth_cm: 3.0) ],
  duration_days: 90,
  events: [ (tick: 792, kind: SetIrrigation(soil: 0, irrigation: None)) ],
)
