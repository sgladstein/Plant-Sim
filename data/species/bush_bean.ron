// Bush bean archetype (Phaseolus vulgaris, determinate type I). Design plan §3.16, §6.1.
// Every number has a unit and a source; "~" means a guess to validate (WP12 tunes these).
Species(
  schema: 1,
  id: "bush_bean",
  name: "Bush bean archetype",
  growth_form: Herb,
  constants: (            // not heritable
    carbon_fraction: (value: 0.45, unit: "g C / g DM", source: "typical (design plan §6.1)"),
    construction_cost: (value: 1.25, unit: "g C / g C", source: "~ (design plan §3.8: 20% growth respiration)"),
    g_function: (value: 0.5, unit: "-", source: "spherical leaf angles"),
    maintenance_rate_20c: (value: 0.218, unit: "g C / g N / day", source: "Ryan 1991, as the CLM base rate 2.525e-6 g C g-1 N s-1 at 20 C (decision 0011; the plan's 0.015 was a per-dry-mass value)"),
    maintenance_q10: (value: 2.0, unit: "-", source: "~ (design plan §3.8)"),
    medlyn_g0: (value: 0.01, unit: "mol/m2/s", source: "~ (design plan §11.4)"),
    rd_q10: (value: 1.92, unit: "-", source: "~ plantecophys 1.4-6 default (decision 0009)"),
    vcmax_activation: (value: 58550.0, unit: "J/mol", source: "~ plantecophys 1.4-6 default, Medlyn 2002 form (decision 0009)"),
    vcmax_deactivation: (value: 200000.0, unit: "J/mol", source: "~ plantecophys 1.4-6 default (decision 0009)"),
    vcmax_entropy: (value: 629.26, unit: "J/mol/K", source: "~ plantecophys 1.4-6 default (decision 0009)"),
    jmax_activation: (value: 29680.0, unit: "J/mol", source: "~ plantecophys 1.4-6 default, Medlyn 2002 form (decision 0009)"),
    jmax_deactivation: (value: 200000.0, unit: "J/mol", source: "~ plantecophys 1.4-6 default (decision 0009)"),
    jmax_entropy: (value: 631.88, unit: "J/mol/K", source: "~ plantecophys 1.4-6 default (decision 0009)"),
    electron_transport_curvature: (value: 0.7, unit: "-", source: "design plan §11.4"),
    quantum_yield: (value: 0.3, unit: "mol/mol", source: "design plan §11.4 (electrons per absorbed photon)"),
    leaf_capacity_floor: (value: 0.4, unit: "-", source: "~ (design plan §3.8)"),
    reserve_floor: (value: 0.05, unit: "g C / g DM", source: "~ (design plan §3.9 step 4)"),
    resorption_fraction: (value: 0.3, unit: "-", source: "~ (design plan §3.9 step 6)"),
    seed_carbon_fraction: (value: 0.45, unit: "g C / g DM", source: "~ (design plan §3.10)"),
    seed_mobilizable_fraction: (value: 0.7, unit: "-", source: "~ (design plan §3.10)"),
    cotyledon_drop_reserve: (value: 0.1, unit: "-", source: "~ (design plan §3.10)"),
    germination_ftsw: (value: 0.3, unit: "-", source: "~ (design plan §3.10)"),
    germination_hours: (value: 24.0, unit: "h", source: "~ (design plan §3.10)"),
    ftsw_threshold: (value: 0.4, unit: "-", source: "~ (design plan §3.6)"),
    starvation_window: (value: 3.0, unit: "day", source: "~ (design plan §3.9, §3.16)"),
    phloem_conductance: (value: 500.0, unit: "g/m/h", source: "~ (moves a leaf's hourly export through a 2 mm stem at a 0.03 g C/g DM gradient; decision 0009)"),
    shade_light_threshold: (value: 0.1, unit: "-", source: "~ (design plan §3.11)"),
    shade_rfr_threshold: (value: 0.7, unit: "-", source: "~ (design plan §3.4)"),
    shade_internode_factor: (value: 1.5, unit: "-", source: "~ (design plan §3.4)"),
    shade_sla_factor: (value: 1.3, unit: "-", source: "~ (design plan §3.4)"),
    leaf_frost_kill: (value: -1.0, unit: "C", source: "~ (design plan §3.11)"),
    growth_t_min: (value: 5.0, unit: "C", source: "~ (design plan §3.11)"),
    growth_t_opt_low: (value: 25.0, unit: "C", source: "~ (design plan §3.11)"),
    growth_t_opt_high: (value: 30.0, unit: "C", source: "~ (design plan §3.11)"),
    growth_t_max: (value: 40.0, unit: "C", source: "~ (design plan §3.11)"),
    heat_abortion_t: (value: 32.0, unit: "C", source: "Gross 1994 (design plan §8.3)"),
    drought_abortion_ftsw: (value: 0.3, unit: "-", source: "~ (design plan §3.11)"),
    raceme_flowering_days: (value: 10.0, unit: "day", source: "~ (design plan §3.11)"),
    pod_expansion: (value: 280.0, unit: "Cd", source: "~ (about 20 days at 14 Cd/day, design plan §3.11)"),
    seed_fill: (value: 280.0, unit: "Cd", source: "~ (about 20 days at 14 Cd/day, design plan §3.11)"),
    specific_root_length: (value: 70.0, unit: "m/g", source: "~ (design plan §3.7, §3.16)"),
    root_uptake_rate: (value: 1e-05, unit: "m2/h", source: "~ (1 cm/cm3 of roots gives 10% of available water per hour)"),
    root_uptake_max: (value: 1.25e-4, unit: "kg/m/h", source: "~ (0.03 cm3 water per cm of root per day, research thread pending its cited report; decision 0012)"),
    stem_density: (value: 150000.0, unit: "g/m3", source: "~"),
    root_density: (value: 100000.0, unit: "g/m3", source: "~"),
    bulk_density: (value: 300000.0, unit: "g/m3", source: "~"),
    pod_aspect: (value: 8.0, unit: "-", source: "~ (bean pods about 10 cm by 1.2 cm)"),
    seed_aspect: (value: 1.5, unit: "-", source: "~ (kidney-shaped seed)"),
    phyllotaxis_angle: (value: 137.5, unit: "deg", source: "botany (design plan §3.4)"),
  ),
  heritable: {            // phenotype parameters with bounds
    "vcmax25": (default: 89.3, min: 40.0, max: 140.0, unit: "umol/m2/s", source: "Pimentel 2011 (design plan §8.2)"),
    "jmax25": (default: 159.8, min: 70.0, max: 260.0, unit: "umol/m2/s", source: "Pimentel 2011 (design plan §8.2)"),
    "rd25": (default: 0.88, min: 0.3, max: 2.0, unit: "umol/m2/s", source: "Pimentel 2011 (design plan §8.2)"),
    "medlyn_g1": (default: 4.0, min: 1.5, max: 8.0, unit: "kPa^0.5", source: "~ herbaceous crop default (design plan §3.8)"),
    "nodes_before_terminal": (default: 7.0, min: 4.0, max: 30.0, unit: "-", source: "~ bush type (design plan §3.16)"),
    "habit": (default: 0.0, min: 0.0, max: 1.0, unit: "0 determinate / 1 indeterminate", source: "botany"),
    "bud_activation": (default: 0.6, min: 0.0, max: 1.0, unit: "-", source: "~"),
    "leaf_area_potential": (default: 75.0, min: 30.0, max: 150.0, unit: "cm2", source: "~ (design plan §3.16: 50 to 100 cm2)"),
    "specific_leaf_area": (default: 250.0, min: 150.0, max: 400.0, unit: "cm2/g", source: "Gebeyehu 2019 (~240), design plan §3.16"),
    "internode_length_potential": (default: 4.5, min: 1.0, max: 20.0, unit: "cm", source: "~ (35 cm height over 7 to 8 nodes, Kumar 2025)"),
    "specific_stem_length": (default: 40.0, min: 10.0, max: 150.0, unit: "cm/g", source: "~"),
    "leaf_lifespan": (default: 600.0, min: 300.0, max: 1000.0, unit: "Cd", source: "~ (design plan §3.11)"),
    "root_elongation_scale": (default: 1.0, min: 0.5, max: 2.0, unit: "-", source: "~"),
    "seed_mass": (default: 0.3, min: 0.15, max: 0.8, unit: "g DM", source: "~ (Kumar 2025: 8.8 g over about 44 seeds; typical 0.2 to 0.5 g)"),
    "seeds_per_pod": (default: 5.0, min: 2.0, max: 8.0, unit: "-", source: "~ (realized mean 3.7 after abortion, Kumar 2025)"),
    "flowers_per_raceme": (default: 6.0, min: 2.0, max: 12.0, unit: "-", source: "~"),
  },
  genome: (               // M0: one locus per trait, zero variance (identity mapping)
    loci: [
      (trait: "vcmax25", effect: 1.0, dominance: 0.0, allele_sd: 0.0),
      (trait: "jmax25", effect: 1.0, dominance: 0.0, allele_sd: 0.0),
      (trait: "rd25", effect: 1.0, dominance: 0.0, allele_sd: 0.0),
      (trait: "medlyn_g1", effect: 1.0, dominance: 0.0, allele_sd: 0.0),
      (trait: "nodes_before_terminal", effect: 1.0, dominance: 0.0, allele_sd: 0.0),
      (trait: "habit", effect: 1.0, dominance: 0.0, allele_sd: 0.0),
      (trait: "bud_activation", effect: 1.0, dominance: 0.0, allele_sd: 0.0),
      (trait: "leaf_area_potential", effect: 1.0, dominance: 0.0, allele_sd: 0.0),
      (trait: "specific_leaf_area", effect: 1.0, dominance: 0.0, allele_sd: 0.0),
      (trait: "internode_length_potential", effect: 1.0, dominance: 0.0, allele_sd: 0.0),
      (trait: "specific_stem_length", effect: 1.0, dominance: 0.0, allele_sd: 0.0),
      (trait: "leaf_lifespan", effect: 1.0, dominance: 0.0, allele_sd: 0.0),
      (trait: "root_elongation_scale", effect: 1.0, dominance: 0.0, allele_sd: 0.0),
      (trait: "seed_mass", effect: 1.0, dominance: 0.0, allele_sd: 0.0),
      (trait: "seeds_per_pod", effect: 1.0, dominance: 0.0, allele_sd: 0.0),
      (trait: "flowers_per_raceme", effect: 1.0, dominance: 0.0, allele_sd: 0.0),
    ],
    mutation_rate: (value: 0.001, unit: "per locus per gamete", source: "design plan §3.12"),
  ),
  phenology: (
    t_base: (value: 8.0, unit: "C", source: "~ (design plan §3.11)"),
    t_opt: (value: 28.0, unit: "C", source: "~ (design plan §3.11)"),
    t_max: (value: 38.0, unit: "C", source: "~ (design plan §3.11)"),
    emergence: (value: 70.0, unit: "Cd", source: "~ (design plan §3.10: 60 to 80)"),
    flowering: (value: 320.0, unit: "Cd", source: "~ (350 from sowing, 40% of 800 in design plan §6.1, less about 30 Cd sowing to germination in moist warm soil; decision 0011)"),
    maturity: (value: 820.0, unit: "Cd", source: "Pinzon-Sandoval 2024, 850 from sowing (design plan §8.2), less about 30 Cd sowing to germination (~; decision 0011)"),
  ),
  roots: [
    RootType(order: 0,
      elongation: (value: 2.0, unit: "cm/day", source: "~"),
      max_length: (value: 60.0, unit: "cm", source: "~"),
      branch_spacing: (value: 1.0, unit: "cm", source: "~"),
      apical_zone: (value: 3.0, unit: "cm", source: "~"),
      insertion_angle: (value: 0.0, unit: "deg", source: "~"),
      gravitropism: 1.0, hydrotropism: 0.5),
    RootType(order: 1,
      elongation: (value: 1.0, unit: "cm/day", source: "~"),
      max_length: (value: 20.0, unit: "cm", source: "~"),
      branch_spacing: (value: 0.5, unit: "cm", source: "~"),
      apical_zone: (value: 1.0, unit: "cm", source: "~"),
      insertion_angle: (value: 70.0, unit: "deg", source: "~"),
      gravitropism: 0.2, hydrotropism: 0.3),
    RootType(order: 2,
      elongation: (value: 0.3, unit: "cm/day", source: "~"),
      max_length: (value: 4.0, unit: "cm", source: "~"),
      branch_spacing: (value: 0.3, unit: "cm", source: "~"),
      apical_zone: (value: 0.5, unit: "cm", source: "~"),
      insertion_angle: (value: 60.0, unit: "deg", source: "~"),
      gravitropism: 0.0, hydrotropism: 0.1),
  ],
  appearance: ( leaf_template: "trifoliate", leaf_color: "#4f8a3a", flower_color: "#f4f0e6", pod_template: "bean_pod" ),
)
