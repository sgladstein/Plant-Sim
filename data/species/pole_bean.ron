  phenology: (
    t_base: (value: 7.0, unit: "C", source: "~ trapezoid 7 / 25 / 33 / 42 C, a synthesis of CROPGRO-Drybean BNGRO048.SPE (vegetative 5/27/37/45, reproductive 5/24/34/44 and 6/25/37/60), Ferreira 1997 (6.8/24.0/34.1) and APSIM bean (7.5/30/40); Dapaah 1999 base 7 (docs/research/retune/items-1-4.md item 2; decision 0032). Was 8 / 28 / 38 single peak"),
    t_opt: (value: 25.0, unit: "C", source: "~ start of the optimum plateau (decision 0032; see t_base)"),
    t_opt_high: (value: 33.0, unit: "C", source: "~ end of the optimum plateau: development stays at its maximum rate from 25 to 33 C, as in CROPGRO, APSIM and Ferreira 1997 (decision 0032)"),
    t_max: (value: 42.0, unit: "C", source: "~ (decision 0032; see t_base)"),
    emergence: (value: 87.0, unit: "Cd", source: "~ (design plan §3.10: 60 to 80); top of the range, as published emergence sums run 58 to 166 Cd on bases 7 to 10 (data/validation/targets.ron; decision 0018); restated from 80.0 for the development trapezoid (decision 0032)"),
    flowering: (value: 613.0, unit: "Cd", source: "bush bean 440 x CROPGRO BNGRO048.CUL EM-FL 34 (Andean H4, climbing) / 26 (H2, bush) (research m2-m3 notes); restated from 575.0 for the development trapezoid (decision 0032)"),
    maturity: (value: 1232.0, unit: "Cd", source: "~ bush bean 900 plus the longer pole-type pod and seed periods (CROPGRO PODUR 14 to 15 vs 10, SD-PM 22 to 25 vs 19 to 21; research m2-m3 notes); restated from 1150.0 for the development trapezoid (decision 0032)"),
  ),
  nitrogen: (             // WP24, decision 0020; protein fractions x 0.16 g N per g protein
