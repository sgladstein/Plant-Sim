// Pole bean archetype (Phaseolus vulgaris, indeterminate climbing type IV). Design plan §3.4, §3.16;
// WP22, decision 0021. The bush bean file with the habit locus set to indeterminate, the
// later pole-type phenology, and longer internodes; everything else is the bush bean's.
// Every number has a unit and a source; "~" means a guess to validate (WP12 tunes these).
Species(
  schema: 20,
  id: "pole_bean",
  name: "Pole bean archetype",
  growth_form: Vine,
  constants: (            // not heritable
    carbon_fraction: (value: 0.45, unit: "g C / g DM", source: "typical (design plan §6.1)"),
    construction_cost_leaf: (value: 1.25, unit: "g C / g C", source: "~ (design plan §3.8: 20% growth respiration). CROPGRO composition gives 1.39 (docs/research/retune/items-1-4.md item 3); held at 1.25 because the per-organ costs weaken the carbon-limited shade internode response below the M0 gate (+17% against 20% on eight seeds); applied with the transport and priority revisit (decision 0032)"),
    construction_cost_stem: (value: 1.25, unit: "g C / g C", source: "~ (design plan §3.8: 20% growth respiration). CROPGRO composition gives 1.29 (docs/research/retune/items-1-4.md item 3); held at 1.25 because the per-organ costs weaken the carbon-limited shade internode response below the M0 gate (+17% against 20% on eight seeds); applied with the transport and priority revisit (decision 0032)"),
    construction_cost_root: (value: 1.25, unit: "g C / g C", source: "~ (design plan §3.8: 20% growth respiration). CROPGRO composition gives 1.25 (docs/research/retune/items-1-4.md item 3); held at 1.25 because the per-organ costs weaken the carbon-limited shade internode response below the M0 gate (+17% against 20% on eight seeds); applied with the transport and priority revisit (decision 0032)"),
    construction_cost_fruit: (value: 1.25, unit: "g C / g C", source: "~ (design plan §3.8: 20% growth respiration). CROPGRO composition gives 1.36 (docs/research/retune/items-1-4.md item 3); held at 1.25 because the per-organ costs weaken the carbon-limited shade internode response below the M0 gate (+17% against 20% on eight seeds); applied with the transport and priority revisit (decision 0032)"),
    maintenance_rate_20c: (value: 0.218, unit: "g C / g N / day", source: "Ryan 1991, as the CLM base rate 2.525e-6 g C g-1 N s-1 at 20 C (decision 0011; the plan's 0.015 was a per-dry-mass value)"),
    maintenance_q10: (value: 2.0, unit: "-", source: "~ (design plan §3.8)"),
    medlyn_g0: (value: 0.01, unit: "mol/m2/s", source: "~ (design plan §11.4)"),
    rd_q10: (value: 1.92, unit: "-", source: "~ plantecophys 1.4-6 default (decision 0009)"),
    vcmax_activation: (value: 58550.0, unit: "J/mol", source: "~ Medlyn 2002 parameter set, peaked Arrhenius form; not plantecophys' defaults (decision 0009)"),
    vcmax_deactivation: (value: 200000.0, unit: "J/mol", source: "~ Medlyn 2002 parameter set (decision 0009)"),
    vcmax_entropy: (value: 629.26, unit: "J/mol/K", source: "~ Medlyn 2002 parameter set (decision 0009)"),
    jmax_activation: (value: 29680.0, unit: "J/mol", source: "~ Medlyn 2002 parameter set, peaked Arrhenius form; not plantecophys' defaults (decision 0009)"),
    jmax_deactivation: (value: 200000.0, unit: "J/mol", source: "~ Medlyn 2002 parameter set (decision 0009)"),
    jmax_entropy: (value: 631.88, unit: "J/mol/K", source: "~ Medlyn 2002 parameter set (decision 0009)"),
    electron_transport_curvature: (value: 0.7, unit: "-", source: "design plan §11.4"),
    quantum_yield: (value: 0.3, unit: "mol/mol", source: "design plan §11.4 (electrons per absorbed photon)"),
    leaf_capacity_floor: (value: 0.4, unit: "-", source: "~ (design plan §3.8)"),
    reserve_floor: (value: 0.05, unit: "g C / g DM", source: "~ (design plan §3.9 step 4)"),
    resorption_fraction: (value: 0.3, unit: "-", source: "~ (design plan §3.9 step 6)"),
    seed_carbon_fraction: (value: 0.45, unit: "g C / g DM", source: "~ (design plan §3.10)"),
    seed_mobilizable_fraction: (value: 0.7, unit: "-", source: "~ (design plan §3.10)"),
    cotyledon_drop_reserve: (value: 0.1, unit: "-", source: "~ (design plan §3.10)"),
    germination_ftsw: (value: 0.3, unit: "-", source: "~ (design plan §3.10)"),
    germination_hours: (value: 24.0, unit: "h", source: "~ (design plan §3.10)"),
    ftsw_expansion_threshold: (value: 0.55, unit: "-", source: "Sadras and Milroy 1996 expansion threshold (research review /mnt/project-files/research/plant-simulation-science-review.md, item 8)"),
    starvation_window: (value: 3.0, unit: "day", source: "~ (design plan §3.9, §3.16)"),
    phloem_conductance: (value: 1500.0, unit: "g/m/h", source: "~ three times the bush bean: climbing stems conduct more per cross-section than self-supporting ones (wider vessels and more phloem; Ewers 1985, Ewers and Fisher 1991), so the thin 2.6 mm twining stem carries its leaves' export to the apex; at 500 the upper internodes reach 70% of potential (review of WP22, decision 0021)"),
    shade_light_threshold: (value: 0.1, unit: "-", source: "~ (design plan §3.11)"),
    shade_rfr_threshold: (value: 0.7, unit: "-", source: "~ (design plan §3.4)"),
    shade_dli_onset: (value: 30.0, unit: "mol/m2/day", source: "~ low-light acclimation starts below the absorbed PAR of an upper leaf on an average temperate summer day (about 25 to 45 mol/m2/day in the open); SLA, stem elongation and leaf mass per area respond to daily light integral over 1 to 50 mol/m2/day (Poorter et al. 2019 meta-analysis); calibrated to the WP12 shade responses (decision 0018)"),
    shade_dli_full: (value: 8.0, unit: "mol/m2/day", source: "~ full low-light response; lower leaves of the 50% shade pots (decision 0018)"),
    shade_internode_factor: (value: 2.6, unit: "-", source: "Lopes et al. 1987, read at full shade: height +159% at 30% light with leaf number unchanged, so about 2.6x at the full low-light index; the 50% shade pots reach an index of about 0.4, which gives about 1.7x (the paper: about 2x at 62% light). Was 2.0, the 62% light value read as the maximum (R2a, decision 0037; decision 0018)"),
    shade_pod_set_factor: (value: 0.5, unit: "-", source: "~ shading raises flower and young-pod abscission in bean; pod number -35% under 45% less PAR (Cossu et al. 2021, Fig. 6B). Calibrated in WP12 at 0.2 (decision 0018); raised to 0.5 when realistic roots made the node reserve lower in shade and pods fell 56% (R2a, decision 0037)"),
    shade_sla_factor: (value: 1.4, unit: "-", source: "~ Cossu et al. 2021: SLA up to +32% under 45% less PAR (design plan §3.4 had ~1.3; decision 0018)"),
    leaf_frost_kill: (value: -2.2, unit: "C", source: "CROPGRO bean SPE FREEZ1 (research review); read against the leaf's own temperature since WP27 (owner decision 2026-11-05, decision 0034), the growing points against air"),
    growth_t_min: (value: 5.0, unit: "C", source: "~ (design plan §3.11)"),
    growth_t_opt_low: (value: 25.0, unit: "C", source: "~ (design plan §3.11)"),
    growth_t_opt_high: (value: 30.0, unit: "C", source: "~ (design plan §3.11)"),
    growth_t_max: (value: 40.0, unit: "C", source: "~ (design plan §3.11)"),
    pod_set_t_min: (value: 7.0, unit: "C", source: "CROPGRO bean SPE pod-set temperature response (research review item 19)"),
    pod_set_t_opt_low: (value: 22.0, unit: "C", source: "CROPGRO bean SPE (research review item 19)"),
    pod_set_t_opt_high: (value: 25.0, unit: "C", source: "CROPGRO bean SPE (research review item 19)"),
    pod_set_t_max: (value: 36.0, unit: "C", source: "CROPGRO bean SPE (research review item 19)"),
    drought_abortion_ftsw: (value: 0.5, unit: "-", source: "CROPGRO: reproductive water stress acts below SWFAC 0.5 (design plan §3.11); was 0.3 (decision 0018)"),
    raceme_flowering_days: (value: 10.0, unit: "day", source: "~ (design plan §3.11)"),
    flower_lifespan: (value: 3.0, unit: "day", source: "~ (decision 0013)"),
    pod_set_base: (value: 0.42, unit: "-", source: "Binnie and Clifford 1981: 45 to 80% of flowers and young pods drop, so 0.2 to 0.55 (research review item 20); 0.42 so a lone pot plant sets 11 to 14 pods (decision 0018)"),
    ovule_set: (value: 0.75, unit: "-", source: "~ (5 ovules, realized 3.7 seeds per pod, Kumar 2025)"),
    pod_wall_mass: (value: 0.6, unit: "g DM", source: "~ (pod wall about a third of pod mass at 4 seeds of 0.3 g)"),
    pod_expansion: (value: 154.0, unit: "Cd", source: "CROPGRO LNGSH 8 photothermal days (research review item 18); restated from 145.0 for the development trapezoid (decision 0032)"),
    seed_fill_delay: (value: 74.0, unit: "Cd", source: "CROPGRO about 3.5 photothermal days after pod start (research review item 18); restated from 70.0 for the development trapezoid (decision 0032)"),
    seed_fill: (value: 350.0, unit: "Cd", source: "~ calibrated to the pole's later maturity, not a CROPGRO cultivar value: 18 photothermal days, within CROPGRO's SFDUR 15 to 22 (research review item 18); with growth stopping at maturity the climbing generic's 22 (Andean Habit 4, 424 Cd) would cut the pole row's seed a further 9% (decision 0042 review); restated from 330.0 for the development trapezoid (decision 0032)"),
    phyllochron: (value: 59.5, unit: "Cd", source: "CROPGRO TRIFL 0.34 leaves per thermal day, about 53 to 65 Cd per node (research review); restated from 55.0 for the development trapezoid (decision 0032)"),
    leaf_expansion: (value: 162.0, unit: "Cd", source: "~ (decision 0013); restated from 150.0 for the development trapezoid (decision 0032)"),
    internode_expansion: (value: 130.0, unit: "Cd", source: "~ (decision 0013); restated from 120.0 for the development trapezoid (decision 0032)"),
    unifoliate_area: (value: 20.0, unit: "cm2", source: "~ 15 to 25 cm2 (research review, WP8 section)"),
    leaf_first_fraction: (value: 0.5, unit: "-", source: "~ placeholder profile, rising to 1 by trifoliate 3 (research review, WP8 section)"),
    leaf_last_fraction: (value: 0.7, unit: "-", source: "~ placeholder profile (research review, WP8 section)"),
    branch_leaf_fraction: (value: 0.8, unit: "-", source: "~ placeholder (research review, WP8 section)"),
    internode_first_fraction: (value: 0.5, unit: "-", source: "~ shape of CROPGRO YVSHT, short nodes 2 to 3 (research review, WP8 section)"),
    internode_last_fraction: (value: 1.75, unit: "-", source: "~ the climbing stem's long upper internodes, 21 cm at full length; tuned to the WP22 height target (decision 0021), re-tuned on seed means at the development trapezoid, which ends node production sooner after flowering (decision 0032; was 1.6)"),
    branch_internode_fraction: (value: 0.7, unit: "-", source: "~ placeholder 0.6 to 0.8 (research review, WP8 section)"),
    petiole_length: (value: 8.0, unit: "cm", source: "~"),
    hypocotyl_above: (value: 4.0, unit: "cm", source: "~"),
    branch_nodes: (value: 3.0, unit: "-", source: "~ 2 to 5 trifoliates per branch (research review, WP8 section)"),
    branch_angle: (value: 45.0, unit: "deg", source: "~"),
    pod_set_reserve_reference: (value: 0.22, unit: "g C / g DM", source: "~ node reserve at which a flower sets with the full base probability; near the reserve of a well-fed plant (feedback halfway between onset 0.10 and full 0.30), so pod set follows the carbon supply below it (decision 0018)"),
    bud_reserve_reference: (value: 0.1, unit: "g C / g DM", source: "~ (Helios flower-abortion threshold 0.1, research review item 22)"),
    apical_dominance_nodes: (value: 0.7, unit: "-", source: "~ WP25 (decision 0024): with the hold below, dominance fades within about one node; chosen with the hold by a sweep that keeps the 90-day bean, the 20-seed pod sweep and the unstaked pole row in range"),
    apical_hold_nodes: (value: 1.5, unit: "-", source: "~ WP25 (decision 0024): the axillary buds of the top nodes (1.5 here) below a growing bean apex stay dormant until it is cut or stops; decapitation releases them within days (Cline 1991, review of apical dominance, bean as the classic system) [K, to verify]"),
    cotyledon_lifespan: (value: 14.0, unit: "day", source: "~ (design plan §3.10)"),
    leaf_absorptance: (value: 0.85, unit: "-", source: "typical green leaf PAR absorptance"),
    leaf_width: (value: 0.08, unit: "m", source: "~ width of a full-grown bean leaflet across the wind (range 0.05 to 0.11; docs/research/wp27-leaf-energy-balance notes/boundary_layer_wind.md); one value for every leaflet (decision 0034)"),
    leaf_nir_absorptance: (value: 0.20, unit: "-", source: "~ PROSPECT-D runs and Goudriaan's NIR scattering 0.8 (range 0.15 to 0.22; research notes/leaf_optics.md)"),
    leaf_emissivity: (value: 0.97, unit: "-", source: "Chen 2015 review (bean 0.957, Fuchs and Tanner 1966); tealeaves default 0.97 (range 0.95 to 0.99; research notes/leaf_optics.md)"),
    abaxial_conductance_share: (value: 0.875, unit: "-", source: "abaxial stomata about 7 times as many as adaxial in bean (Kanemasu and Tanner 1969, abstract; research notes/boundary_layer_wind.md)"),
    root_segment_length: (value: 2.0, unit: "cm", source: "model resolution (decision 0013)"),
    shoot_gravitropism: (value: 0.3, unit: "-", source: "~ (decision 0013)"),
    phototropism_weight: (value: 0.3, unit: "-", source: "~ R1 spec §5 (decision 0041): a new internode turns 0.3 of the angle toward the light it saw, before gravitropism pulls it 0.3 of the way to vertical"),
    phototropism_max_per_day: (value: 10.0, unit: "deg", source: "~ conservative; seedlings of sunflower and pea bend about 25 degrees in 2 h, and no bean stem kinetics were found (R1 numbers, docs/research/realism-plan/numbers/README.md; decision 0041)"),
    root_dry_full: (value: 0.3, unit: "-", source: "~ R2b spec §4 (decision 0043): tips slow linearly below 0.3 of available water (theta_full), a guess"),
    root_dry_floor: (value: 0.3, unit: "-", source: "R2 numbers change 5: maize and soybean primary root tips keep full elongation in the apical 3 to 4 mm near -1.6 MPa (Sharp 2004; Yamaguchi 2010), so a floor of about 0.3 on the factor (decision 0043)"),
    xerobranching_threshold: (value: 0.1, unit: "-", source: "~ R2b spec §4: no lateral forms where the parent root crosses soil below 0.1 of available water, and none forms later (Orman-Ligeza 2018, barley; the effect looked irreversible, R2 numbers change 5; decision 0043)"),
    root_proliferation_nitrate: (value: 1.0, unit: "-", source: "~ R2b spec §4: laterals in a cell up to 3x where nitrate is 2x the root zone mean or more (Drew 1975 several-fold in barley [K]; 1.5 to 4 in Arabidopsis, Zhang 1999, Linkohr 2002; no legume data; decision 0043)"),
    root_proliferation_water: (value: 0.5, unit: "-", source: "~ R2b spec §4, a guess (decision 0043)"),
    hydropatterning: (value: 1.0, unit: "-", source: "R2b spec §4: about 80% of laterals start on the wet side (Bao 2014 [F, secondary]; decision 0043)"),
    hydrotropism_weight: (value: 0.05, unit: "-", source: "~ R2b spec §4: weak in soil (Dietrich 2017, MIZ1 [K]); a quarter of the gravity term at full gravitropism (decision 0043)"),
    shade_senescence_days: (value: 5.0, unit: "day", source: "design plan §3.11"),
    hypocotyl_specific_length: (value: 150.0, unit: "cm/g", source: "~ thin, watery hypocotyl the seed reserve can pay for (decision 0013)"),
    reserve_feedback_onset: (value: 0.10, unit: "g C / g DM", source: "~ leaf reserve where end-product inhibition starts, about 18% non-structural carbohydrate in total dry mass (L-PEACH style feedback, Allen et al. 2005; decision 0013)"),
    reserve_feedback_full: (value: 0.30, unit: "g C / g DM", source: "~ leaf reserve where photosynthetic capacity reaches zero, about 40% non-structural carbohydrate in total dry mass (decision 0013)"),
    root_radial_conductivity: (value: 2e-7, unit: "m/s/MPa", source: "Fiscus and Markhart 1979, whole bean root systems, 0.8 to 6e-7 (R3 numbers [F])"),
    root_radial_conductivity_thickened: (value: 5e-8, unit: "m/s/MPa", source: "~ suberized over young root about 0.39 in pine (R3 numbers [I])"),
    root_axial_conductance_tip: (value: 2e-11, unit: "m4/s/MPa", source: "Barrios-Gomez 2012 tap-root apex metaxylem 29 um by Hagen-Poiseuille x 0.4 (R3 numbers [F] anatomy, [I] value); laterals and fine roots take it too (~)"),
    root_axial_conductance_tap: (value: 2e-9, unit: "m4/s/MPa", source: "Barrios-Gomez 2012 tap-root base metaxylem 66 um by Hagen-Poiseuille x 0.4 (R3 numbers [F] anatomy, [I] value)"),
    root_axial_conductance_basal: (value: 1e-10, unit: "m4/s/MPa", source: "Massas 2022, wild P. vulgaris basal root 8.9e-11, 800-fold range across Phaseolus (R3 numbers [F])"),
    root_axial_maturation: (value: 20.0, unit: "cm", source: "~ the tap root's metaxylem widens from apex to base (Barrios-Gomez 2012); R3b takes 20 cm from the tip for the mature value, rising log-linearly"),
    stem_xylem_conductivity: (value: 9.8, unit: "kg/m/s/MPa", source: "~ calibrated so a 5 mm stem with the area fraction below has Holste 2006's bean stem k_h 2.9e-5 kg m s-1 MPa-1 (R3 numbers [F]); stem resistance is about 1000 times below the leaf's, so it is not tuned"),
    xylem_area_fraction: (value: 0.15, unit: "-", source: "~ no source found (R3 numbers gap); only the product with the conductivity matters"),
    leaf_hydraulic_conductance: (value: 8.7, unit: "mmol/m2/s/MPa", source: "back-calculated from Haverroth 2025, 5 to 15 (R3 numbers [I]); no vulnerability curve in R3b (P12 -0.72, P50 -1.00 MPa)"),
    tuzet_sensitivity: (value: 4.0, unit: "1/MPa", source: "fit to bean closure starting at -0.4 to -0.6 MPa and about -1.2 MPa, 3 to 6 (R3 numbers [F] anchors, [I] fit; Tuzet 2003 form as in plantecophys)"),
    tuzet_reference: (value: -1.0, unit: "MPa", source: "fit to the same anchors (R3 numbers [I]); plantecophys's generic -1.9 is too drought-tolerant for bean"),
    turgor_loss_point: (value: -0.9, unit: "MPa", source: "Zlatev and Stoyanov 2005, well watered, -0.6 to -1.3; Haverroth 2025 -0.83 (R3 numbers [F])"),
    turgor_full: (value: -0.2, unit: "MPa", source: "R3b spec §4.4 (Zlatev and Stoyanov 2005; Haverroth 2025 [F])"),
    hydraulic_compensation: (value: 1.0, unit: "-", source: "~ Couvreur et al. 2012 compensation conductance over K_rs; the R3 numbers note keeps K_comp a parameter defaulting to K_rs, the knob for the fidelity report's hard cases"),
    hypoxia_radial_factor: (value: 0.3, unit: "-", source: "~ R5b spec §4 (decision 0048): anoxia closes root aquaporins within hours (Tournaire-Roux et al. 2003, Arabidopsis), and waterlogged common bean leaves dehydrate within hours (Schildwacht 1989; Haverroth et al. 2024); the share a guess"),
    hypoxia_n_uptake_factor: (value: 0.2, unit: "-", source: "~ R5b spec §4: a hypoxic root takes up little nitrogen, a guess"),
    hypoxia_fine_root_death: (value: 48.0, unit: "h", source: "~ R5b spec §4: fine roots of a flooding-sensitive legume die within about two days of hypoxia (common bean is among the most flooding-sensitive crops, Soltani et al. 2017), a guess"),
    hypoxia_root_death: (value: 120.0, unit: "h", source: "~ R5b spec §4: axes and laterals outlast fine roots, a guess"),
    root_impedance_half: (value: 1.0, unit: "MPa", source: "~ R5c spec §5 (decision 0049): root elongation is halved at penetrometer resistances of 0.8 MPa (cotton) to 2 MPa (maize, peanut) in repacked soil without water stress (Bengough et al. 2011); bean, a dicot, set at the spec's 1 MPa"),
    root_impedance_thickening: (value: 0.33, unit: "1/MPa", source: "wheat seminal roots 17 to 20% wider in sand at 0.75 MPa than at 0.19 MPa (Ge et al. 2019, Table 3), about 0.33 per MPa; R5c spec §5 (decision 0049); no bean data"),
    root_impedance_max_thickening: (value: 2.0, unit: "-", source: "~ R5c spec §5 (decision 0049): impeded roots up to about twice as thick (Bengough et al. 2011 review [K, to verify])"),
    root_impedance_branching: (value: 1.0, unit: "-", source: "~ R5c spec §5 (decision 0049): laterals form more densely behind an impeded tip (Goss 1977, barley [K, to verify]); up to twice as dense behind a stopped tip, a guess"),
    stem_density: (value: 150000.0, unit: "g/m3", source: "~"),
    root_density: (value: 94000.0, unit: "g/m3", source: "OpenSimRoot bean root tissue density 0.094 g/cm3 (research review item 16)"),
    bulk_density: (value: 300000.0, unit: "g/m3", source: "~"),
    pod_aspect: (value: 8.0, unit: "-", source: "~ (bean pods about 10 cm by 1.2 cm)"),
    seed_aspect: (value: 1.5, unit: "-", source: "~ (kidney-shaped seed)"),
    phyllotaxis_angle: (value: 180.0, unit: "deg", source: "~ distichous candidate; the plan's 137.5 is the spiral angle and no bean source supports it (research review item 17)"),
  ),
  heritable: {            // phenotype parameters with bounds
    "vcmax25": (default: 89.3, min: 40.0, max: 140.0, unit: "umol/m2/s", source: "Pimentel 2011 (design plan §8.2)"),
    "jmax25": (default: 159.8, min: 70.0, max: 260.0, unit: "umol/m2/s", source: "Pimentel 2011 (design plan §8.2)"),
    "rd25": (default: 0.88, min: 0.3, max: 2.0, unit: "umol/m2/s", source: "Pimentel 2011 (design plan §8.2)"),
    "medlyn_g1": (default: 5.79, min: 1.5, max: 8.0, unit: "kPa^0.5", source: "CLM5 PFT table (Lin et al. 2015): 5.79 for temperate and tropical soybean, spring wheat, cotton and rice; soybean is the nearest legume, no bean value found (docs/research/retune/items-1-4.md item 4; decision 0032). Was 4.0, a herbaceous default (design plan §3.8)"),
    "nodes_before_terminal": (default: 7.0, min: 4.0, max: 30.0, unit: "-", source: "~ for a vine, the main-stem node of the first raceme (decision 0021)"),
    "habit": (default: 0.0, min: 0.0, max: 1.0, unit: "0 determinate / 1 indeterminate", source: "botany: the fin fin baseline; this file's line carries Fin Fin, so its plants are indeterminate (Gonzalez 2016; decision 0023)"),
    "bud_activation": (default: 0.6, min: 0.0, max: 1.0, unit: "-", source: "~"),
    "leaf_area_potential": (default: 133.0, min: 50.0, max: 180.0, unit: "cm2", source: "CROPGRO SIZLF 133 for Type I (research review item 21); the realized mean near 60 should emerge"),
    "specific_leaf_area": (default: 305.0, min: 150.0, max: 400.0, unit: "cm2/g", source: "CROPGRO SLAVR 305 to 315 for new Type I leaves (research review)"),
    "internode_length_potential": (default: 12.0, min: 1.0, max: 20.0, unit: "cm", source: "~ 6 cm at node 2 rising to 19 cm from node 10 with the profile fractions; above Rutjens 2025 Lmax 5 to 15 cm, tuned to the WP22 height target (decision 0021)"),
    "specific_stem_length": (default: 120.0, min: 10.0, max: 150.0, unit: "cm/g", source: "~ a 2.6 mm twining stem at the species stem density (150 kg/m3 dry); the bush bean's stem is thicker (decision 0021)"),
    "leaf_lifespan": (default: 650.0, min: 325.0, max: 1080.0, unit: "Cd", source: "~ (design plan §3.11); restated x1.08 from 600 (300 to 1000) for the development trapezoid (decision 0032)"),
    "root_elongation_scale": (default: 1.0, min: 0.5, max: 2.0, unit: "-", source: "~"),
    "seed_mass": (default: 0.3, min: 0.15, max: 0.8, unit: "g DM", source: "~ (Kumar 2025: 8.8 g over about 44 seeds; typical 0.2 to 0.5 g)"),
    "seeds_per_pod": (default: 5.0, min: 2.0, max: 8.0, unit: "-", source: "~ (realized mean 3.7 after abortion, Kumar 2025)"),
    "flowers_per_raceme": (default: 6.0, min: 2.0, max: 12.0, unit: "-", source: "~"),
  },
  genome: (               // schema 8, WP28, decision 0029: pure-line QTL and named loci with light linkage
