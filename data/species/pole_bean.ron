    internode_ramp_nodes: (value: 8.0, unit: "-", source: "~ CROPGRO YVSHT reaches full length by about node 10 (research m2-m3 notes)"),
    circumnutation_radius: (value: 6.0, unit: "cm", source: "~ 3 to 10 cm (Sothern 1998 for Glycine soja, 2.9 to 8.7 cm; research m2-m3 notes)"),
    circumnutation_growth: (value: 0.25, unit: "-", source: "~ the circumnutating tip is the free stem above the last hold, and its swing widens as that free length grows (Darwin 1875 describes revolving shoots sweeping wider circles as they lengthen); 0.25 is a lean of about 15 degrees from the vertical, to validate (decision 0029)"),
    circumnutation_radius_max: (value: 15.0, unit: "cm", source: "~ a cap so a long free tip (it lodges at self_support_length) does not reach a stake across a row; to validate against measured bean circumnutation amplitudes (decision 0029)"),
    support_diameter_sure: (value: 5.0, unit: "cm", source: "Darwin 1875; research m2-m3 notes: certain capture up to 5 cm"),
    support_diameter_max: (value: 20.0, unit: "cm", source: "Darwin 1875 (fails on 23 cm); research m2-m3 notes: capture falls to 0 at 10 to 20 cm"),
    helix_pitch: (value: 14.0, unit: "cm", source: "~ tuned on seed means to the staked height target (decision 0029): 14 cm per turn gives about 68 deg on the 1.5 cm stake, inside Rutjens 2025's 35 to 75 deg; thin strings stay at the 75 deg clamp. Was 10 (review of WP22), which gave about 60 deg on the stake and 10% less height per metre of stem than on a string; Rutjens 2025 pitch p = 2 pi R tan(eta)"),
    helix_inclination_min: (value: 35.0, unit: "deg", source: "Rutjens 2025: 35 to 75 deg"),
    helix_inclination_max: (value: 75.0, unit: "deg", source: "Rutjens 2025: 35 to 75 deg"),
    self_support_length: (value: 40.0, unit: "cm", source: "~"),
    heap_radius: (value: 15.0, unit: "cm", source: "~ a fallen vine coils back on itself"),
    lodge_height: (value: 2.0, unit: "cm", source: "~ a fallen stem lies on the soil"),
    pod_rot_rate: (value: 0.017, unit: "1/day", source: "~ staking keeps pods off wet soil and cuts pod rot (IITA PROPAS; Reckling 2011); set so unstaked yield falls inside the -30 to -70% band (decision 0021), re-set on seed means at model 0.12.0 when every staked row plant found its string (decision 0029)"),
  ),
  variation: (            // schema 7 (decision 0027), 8 (decision 0029): non-heritable plant-to-plant variation within a pure line
    seed_mass_cv: (value: 0.12, unit: "-", source: "~ single seeds of one bean seed lot: about 10 to 15% CV (individual seed mass is set by pod position and maternal resources; 100-seed weight PCV 15% across landraces, Mesera 2022, is between lots)"),
    seed_leaf_exponent: (value: 0.5, unit: "-", source: "~ the unifoliate leaves are preformed in the embryo, and larger bean seeds give larger primary leaves and early seedlings (seed-size vigour); square root as a partial effect"),
    emergence_cv: (value: 0.15, unit: "-", source: "~ hydrothermal time: each seed of a lot has its own threshold, normally distributed (Gummerson 1986; Bradford 2002), so a sowing comes up over several days; 15% of 80 Cd is about a day either side at 12 Cd per day"),
    emergence_per_depth: (value: 13.0, unit: "Cd/cm", source: "~ the hypocotyl hook pushes up about 1 cm per 10 to 15 Cd; CERES-Wheat uses 10.2 Cd per cm for a coleoptile, and an epigeal bean lifting its cotyledons is a little slower; restated from 12.0 for the development trapezoid (decision 0032)"),
    emergence_reference_depth: (value: 3.0, unit: "cm", source: "the emergence sum was set for the 3 cm the scenarios sow at (decision 0018)"),
    leaf_size_cv: (value: 0.1, unit: "-", source: "~ leaf-to-leaf scatter of final leaflet area about the node profile, about 10% in field leaf-area surveys"),
    divergence_sd: (value: 10.0, unit: "deg", source: "~ measured divergence angles scatter by about 5 to 15 degrees about the ideal angle"),
    internode_length_cv: (value: 0.1, unit: "-", source: "~ internode-to-internode scatter of final length about the node profile, about 10%, matching leaf_size_cv; with emergence spread it brings stand height CV toward the 10% field stands show (variation review item 6, decision 0029)"),
  ),
  thickening: (           // schema 12, R1a, decision 0036: stem and root secondary growth
    secondary_growth: (value: 1.0, unit: "-", source: "botany: a dicot with a vascular cambium; bean stems and tap roots widen through the season"),
    pipe_area_per_leaf_area: (value: 3.0e-4, unit: "m2/m2", source: "~ whole-stem Huber value: basal stem area over plant leaf area 1.5e-4 to 3.1e-4 from field stem diameters (Rodriguez Rodriguez 2026; Anjos 2018) and UFGA8501 LAI (R1 numbers, research thread); calibrate to basal_stem_diameter"),
    pipe_area_per_fruit_mass: (value: 0.0, unit: "m2/g", source: "~ off: no pod-load term unless calibration needs one (R1 spec §3.2)"),
    stem_radial_rate_max: (value: 0.1, unit: "mm/day", source: "~ a cap: a bean hypocotyl needs 0.02 to 0.05 mm/day on average, sunflower about 0.15 (Radu & Gurau 2023; R1 numbers, research thread)"),
  ),
  root_secondary_rate: (  // schema 12, R1a: root diameter growth by segment age, before each type's factor
    points: [(0.0, 0.0), (4.0, 0.0005), (5.0, 0.001), (7.0, 0.0015), (11.0, 0.002), (13.0, 0.0023), (18.0, 0.0026), (24.0, 0.00285), (29.0, 0.003)],
    x_unit: "day", unit: "cm/day",
    source: "OpenSimRoot bean (Carioca) growthrates.xml, secondaryGrowthRate by root segment age: a diameter increment that adds 0.1 cm in 43 days"),
  storage: (              // schema 14, R1b, decision 0040: the starch store of stems and main roots, and root exudation
    storage_capacity: (value: 0.25, unit: "g / g DM", source: "~ calibrated to the stem dry mass decline in seed fill (R1 spec §6: -10 to -35%, UFGA8501), within 0.15 to 0.30; greenhouse bean stem starch reaches 30 to 68% of dry mass (Waters et al. 1980), a ceiling (R1 numbers, research thread)"),
    root_storage_capacity: (value: 0.25, unit: "g / g DM", source: "~ the stem value: the bean tap root stores starch in its secondary xylem and phloem parenchyma (R1 spec §4.4, \"0.25 bean stem and root\")"),
    storage_on: (value: 0.15, unit: "g C / g DM", source: "~ above the leaves' sink feedback onset 0.10, so a stem stores only sugar the leaves are already holding back; at 0.12 (R1 spec §4.4) the store took sugar that growing organs needed, since their growth follows their reserve: the pot bean set 9.8 pods against 12.5, and wheat stood 3% shorter (four-seed means; R1b, decision 0040)"),
    storage_off: (value: 0.06, unit: "g C / g DM", source: "~ just above the growth floor 0.05, so the store gives back before growth stops (R1 spec §4.4)"),
    storage_refill_rate: (value: 0.05, unit: "1/h", source: "~ fills about 70% of an empty store in a day of surplus (R1 spec §4.4)"),
    storage_release_rate: (value: 0.02, unit: "1/h", source: "~ gives back about 40% of the store in a day of shortage; bean stem starch fell 42% in 7 days of pod fill (Waters et al. 1980) (R1 spec §4.4)"),
    storage_fill_release_rate: (value: 0.08, unit: "1/day", source: "~ from seed fill the store stops refilling and gives back this share a day whatever the reserve: bean stem starch fell 42% in 7 days of pod fill (Waters et al. 1980), about 0.08 a day; stem sugars fall from about 7% to 1.6% of dry mass through fill (Pena-Valdivia 1991) (R1 numbers, research thread)"),
    exudation_fraction: (value: 0.4, unit: "-", source: "legume exudates are about 2.7% of assimilated 14C (Warembourg 2003), rhizodeposition 5 to 10% of assimilated C (Nguyen 2003), bean root respiration about 20% of daytime assimilation (Nielsen 2001): 0.1 to 0.5 of root respiration; OpenSimRoot bean exudates.xml has 0.67 (R1 numbers, research thread)"),
  ),
