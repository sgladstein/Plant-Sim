    nodule_depth: (value: 30.0, unit: "cm", source: "~ most bean nodules sit in the top 20 to 30 cm; CROPGRO weights the top 50 cm"),
    fixation_cost: (value: 7.1, unit: "g C / g N", source: "CROPGRO-Drybean BNGRO048.SPE RFIXN 2.83 g CH2O per g protein / 0.16 x 0.4 (research m2-m3 notes, correction section)"),
