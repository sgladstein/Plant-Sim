    seed_n_initial: (value: 0.0376, unit: "g N / g DM", source: "CROPGRO-Drybean BNGRO048.SPE PROSDI 0.235 x 0.16; OpenSimRoot seed N about 10 mg in a 0.3 g seed"),
    seed_n_final: (value: 0.02, unit: "g N / g DM", source: "~ seeds keep filling down to about half their normal protein"),
    nodule_n: (value: 0.048, unit: "g N / g DM", source: "CROPGRO-Drybean BNGRO048.SPE PRONOD 0.30 x 0.16"),
    leaf_n_area_base: (value: 0.3, unit: "g N / m2", source: "~ Kattge 2009 and Walker 2014 intercept, Vcmax25 = b (Na - 0.3) (research m2-m3 notes row 21, to verify)"),
    uptake_capacity: (value: 6.0e-4, unit: "g N / m / day", source: "CROPGRO-Drybean BNGRO048.SPE RTNO3 = RTNH4, 0.006 mg N per cm of root per day for each form, applied to the sim's own root length in each cell; the 25x factor and the 4 cm reach that stood in for missing roots are gone now that laterals keep up with their tips and fine roots exist (R2a, decision 0037)"),
    mobilization_rate: (value: 0.12, unit: "1/day", source: "CROPGRO-Drybean BNGRO048.SPE NMOBMX"),
    vegetative_mobilization: (value: 0.36, unit: "-", source: "CROPGRO-Drybean BNGRO048.SPE NVSMOB"),
    leaf_drop_mobile: (value: 0.1, unit: "-", source: "~ a leaf mined to within a tenth of its mobile nitrogen drops (CROPGRO drops at the final concentration)"),
