    internode_length_cv: (value: 0.1, unit: "-", source: "~ internode-to-internode scatter of final length about the node profile, about 10%, matching leaf_size_cv; with emergence spread it brings stand height CV toward the 10% field stands show (variation review item 6, decision 0029)"),
  ),
