// Spring wheat (Triticum aestivum, spring type), the M2 grass (WP23, decision 0022).
// Every number has a unit and a source; "~" means a guess to validate. Bean-only
// constants the grass module does not read say so in their source.
Species(
  schema: 13,
  id: "spring_wheat",
  name: "Spring wheat",
  growth_form: Grass,
  constants: (            // not heritable
    carbon_fraction: (value: 0.45, unit: "g C / g DM", source: "typical (design plan §6.1)"),
    construction_cost_leaf: (value: 1.25, unit: "g C / g C", source: "~ (design plan §3.8: 20% growth respiration); the per-organ costs of decision 0032 are bean composition values, not applied to wheat"),
    construction_cost_stem: (value: 1.25, unit: "g C / g C", source: "~ as construction_cost_leaf"),
    construction_cost_root: (value: 1.25, unit: "g C / g C", source: "~ as construction_cost_leaf"),
    construction_cost_fruit: (value: 1.25, unit: "g C / g C", source: "~ as construction_cost_leaf"),
    maintenance_rate_20c: (value: 0.218, unit: "g C / g N / day", source: "Ryan 1991, as the CLM base rate 2.525e-6 g C g-1 N s-1 at 20 C (decision 0011; the plan's 0.015 was a per-dry-mass value)"),
    maintenance_q10: (value: 2.0, unit: "-", source: "~ (design plan §3.8)"),
    medlyn_g0: (value: 0.01, unit: "mol/m2/s", source: "~ (design plan §11.4)"),
    rd_q10: (value: 1.92, unit: "-", source: "~ plantecophys 1.4-6 default (decision 0009)"),
    vcmax_activation: (value: 58550.0, unit: "J/mol", source: "~ Medlyn 2002 parameter set, peaked Arrhenius form; not plantecophys' defaults (decision 0009)"),
    vcmax_deactivation: (value: 200000.0, unit: "J/mol", source: "~ Medlyn 2002 parameter set (decision 0009)"),
    vcmax_entropy: (value: 629.26, unit: "J/mol/K", source: "~ Medlyn 2002 parameter set (decision 0009)"),
    jmax_activation: (value: 29680.0, unit: "J/mol", source: "~ Medlyn 2002 parameter set, peaked Arrhenius form; not plantecophys' defaults (decision 0009)"),
    jmax_deactivation: (value: 200000.0, unit: "J/mol", source: "~ Medlyn 2002 parameter set (decision 0009)"),
    jmax_entropy: (value: 631.88, unit: "J/mol/K", source: "~ Medlyn 2002 parameter set (decision 0009)"),
    electron_transport_curvature: (value: 0.7, unit: "-", source: "design plan §11.4"),
    quantum_yield: (value: 0.3, unit: "mol/mol", source: "design plan §11.4 (electrons per absorbed photon)"),
    leaf_capacity_floor: (value: 0.4, unit: "-", source: "~ (design plan §3.8)"),
    reserve_floor: (value: 0.05, unit: "g C / g DM", source: "~ (design plan §3.9 step 4)"),
    resorption_fraction: (value: 0.3, unit: "-", source: "~ (design plan §3.9 step 6)"),
    seed_carbon_fraction: (value: 0.45, unit: "g C / g DM", source: "~ (design plan §3.10)"),
    seed_mobilizable_fraction: (value: 0.8, unit: "-", source: "~ the endosperm is mostly starch the seedling can use"),
    cotyledon_drop_reserve: (value: 0.1, unit: "-", source: "~ the endosperm is shed once nearly spent"),
    germination_ftsw: (value: 0.3, unit: "-", source: "~ (design plan §3.10)"),
    germination_hours: (value: 24.0, unit: "h", source: "~ (design plan §3.10)"),
    ftsw_threshold: (value: 0.35, unit: "-", source: "Sadras and Milroy 1996 conductance threshold (research review /mnt/project-files/research/plant-simulation-science-review.md, item 8)"),
    ftsw_expansion_threshold: (value: 0.55, unit: "-", source: "Sadras and Milroy 1996 expansion threshold (research review /mnt/project-files/research/plant-simulation-science-review.md, item 8)"),
    starvation_window: (value: 3.0, unit: "day", source: "~ (design plan §3.9, §3.16)"),
    phloem_conductance: (value: 1500.0, unit: "g/m/h", source: "~ as the pole bean (decision 0021): a culm internode 15 to 20 cm long conducts poorly as a solid cylinder, while a grass culm carries many vascular bundles in its wall"),
    shade_light_threshold: (value: 0.1, unit: "-", source: "~ (design plan §3.11)"),
    shade_rfr_threshold: (value: 0.7, unit: "-", source: "~ (design plan §3.4)"),
    shade_dli_onset: (value: 30.0, unit: "mol/m2/day", source: "~ low-light acclimation starts below the absorbed PAR of an upper leaf on an average temperate summer day (about 25 to 45 mol/m2/day in the open); SLA, stem elongation and leaf mass per area respond to daily light integral over 1 to 50 mol/m2/day (Poorter et al. 2019 meta-analysis); calibrated to the WP12 shade responses (decision 0018)"),
    shade_dli_full: (value: 8.0, unit: "mol/m2/day", source: "~ full low-light response; lower leaves of the 50% shade pots (decision 0018)"),
    shade_internode_factor: (value: 1.3, unit: "-", source: "~ wheat stems lengthen less in shade than bean internodes"),
    shade_pod_set_factor: (value: 0.2, unit: "-", source: "unused by the grass"),
    shade_sla_factor: (value: 1.3, unit: "-", source: "~ thinner leaves in shade, as for the bean"),
    leaf_frost_kill: (value: -8.0, unit: "C", source: "~ spring wheat seedlings survive frosts of -6 to -10 C; read against the leaf's own temperature since WP27 (decision 0034), the growing points against air"),
    growth_t_min: (value: 0.0, unit: "C", source: "~ wheat expansion stops near 0 C (APSIM-Wheat [K, to verify])"),
    growth_t_opt_low: (value: 15.0, unit: "C", source: "~ APSIM-Wheat [K, to verify]"),
    growth_t_opt_high: (value: 25.0, unit: "C", source: "~ APSIM-Wheat [K, to verify]"),
    growth_t_max: (value: 35.0, unit: "C", source: "~ APSIM-Wheat [K, to verify]"),
    pod_set_t_min: (value: 0.0, unit: "C", source: "~ floret fertility against the daily maximum around anthesis"),
    pod_set_t_opt_low: (value: 10.0, unit: "C", source: "~"),
    pod_set_t_opt_high: (value: 27.0, unit: "C", source: "~ grain set falls above a 27 to 31 C maximum around anthesis (Porter and Gawith 1999 [K, to verify])"),
    pod_set_t_max: (value: 37.0, unit: "C", source: "~ Porter and Gawith 1999 [K, to verify]"),
    drought_abortion_ftsw: (value: 0.5, unit: "-", source: "unused by the grass"),
    raceme_flowering_days: (value: 10.0, unit: "day", source: "unused by the grass"),
    flower_lifespan: (value: 3.0, unit: "day", source: "unused by the grass"),
    pod_set_base: (value: 0.42, unit: "-", source: "unused by the grass"),
    ovule_set: (value: 0.85, unit: "-", source: "~ share of potential florets that set a grain in a fed ear"),
    pod_wall_mass: (value: 0.45, unit: "g DM", source: "~ chaff (glumes, lemmas and rachis) of a main-stem ear, about a fifth of its mass"),
    pod_expansion: (value: 200.0, unit: "Cd", source: "~ the ear grows over about two phyllochrons around heading"),
    seed_fill_delay: (value: 180.0, unit: "Cd", source: "~ heading to anthesis about 80 Cd, then the grain's lag phase"),
    seed_fill: (value: 550.0, unit: "Cd", source: "~ APSIM-Wheat grain filling about 545 Cd [K, to verify]"),
    phyllochron: (value: 85.0, unit: "Cd", source: "~ spring sowings run shorter phyllochrons as days lengthen (Baker 1980 [K, to verify]); WALTer 99 Cd, field 100 to 117 (research m2-m3 notes)"),
    leaf_expansion: (value: 160.0, unit: "Cd", source: "WALTer: blade extension 1.6 phyllochrons"),
    internode_expansion: (value: 200.0, unit: "Cd", source: "WALTer: internode extension 2 phyllochrons"),
    unifoliate_area: (value: 20.0, unit: "cm2", source: "unused by the grass"),
    leaf_first_fraction: (value: 0.5, unit: "-", source: "unused by the grass (grass.blade_first_fraction)"),
    leaf_last_fraction: (value: 0.7, unit: "-", source: "unused by the grass (grass.blade_flag_fraction)"),
    branch_leaf_fraction: (value: 0.8, unit: "-", source: "unused by the grass"),
    internode_first_fraction: (value: 0.2, unit: "-", source: "~ the lowest elongated internode against the one under the peduncle"),
    internode_last_fraction: (value: 1.0, unit: "-", source: "the internode under the peduncle is the longest below it"),
    branch_internode_fraction: (value: 0.7, unit: "-", source: "unused by the grass"),
    petiole_length: (value: 1.0, unit: "cm", source: "unused by the grass"),
    hypocotyl_above: (value: 1.0, unit: "cm", source: "~ the coleoptile tip shows about 1 cm above the soil"),
    branch_nodes: (value: 3.0, unit: "-", source: "unused by the grass"),
    branch_angle: (value: 45.0, unit: "deg", source: "unused by the grass"),
    pod_set_reserve_reference: (value: 0.22, unit: "g C / g DM", source: "~ node reserve at which a flower sets with the full base probability; near the reserve of a well-fed plant (feedback halfway between onset 0.10 and full 0.30), so pod set follows the carbon supply below it (decision 0018)"),
    bud_reserve_reference: (value: 0.1, unit: "g C / g DM", source: "~ (Helios flower-abortion threshold 0.1, research review item 22)"),
    apical_dominance_nodes: (value: 2.0, unit: "-", source: "unused by the grass"),
    apical_hold_nodes: (value: 0.0, unit: "-", source: "unused by the grass"),
    cotyledon_lifespan: (value: 21.0, unit: "day", source: "~ the endosperm feeds the seedling for about three weeks"),
    leaf_absorptance: (value: 0.85, unit: "-", source: "typical green leaf PAR absorptance"),
    leaf_width: (value: 0.015, unit: "m", source: "~ spring wheat flag and upper blades, 12 to 22 mm (research notes/boundary_layer_wind.md); one value for every blade (decision 0034)"),
    leaf_nir_absorptance: (value: 0.20, unit: "-", source: "~ PROSPECT-D runs and Goudriaan's NIR scattering 0.8 (range 0.15 to 0.22; research notes/leaf_optics.md)"),
    leaf_emissivity: (value: 0.97, unit: "-", source: "Chen 2015 review; tealeaves default 0.97 (range 0.95 to 0.99; research notes/leaf_optics.md)"),
    abaxial_conductance_share: (value: 0.5, unit: "-", source: "~ wheat is amphistomatous with about equal stomatal densities on both faces [K, to verify] (research notes/boundary_layer_wind.md)"),
    root_segment_length: (value: 2.0, unit: "cm", source: "model resolution (decision 0013)"),
    shoot_gravitropism: (value: 0.3, unit: "-", source: "~ (decision 0013)"),
    shade_senescence_days: (value: 5.0, unit: "day", source: "design plan §3.11"),
    hypocotyl_specific_length: (value: 1500.0, unit: "cm/g", source: "~ a thin coleoptile and subcrown internode the small grain can pay for"),
    reserve_feedback_onset: (value: 0.10, unit: "g C / g DM", source: "~ leaf reserve where end-product inhibition starts, about 18% non-structural carbohydrate in total dry mass (L-PEACH style feedback, Allen et al. 2005; decision 0013)"),
    reserve_feedback_full: (value: 0.30, unit: "g C / g DM", source: "~ leaf reserve where photosynthetic capacity reaches zero, about 40% non-structural carbohydrate in total dry mass (decision 0013)"),
    root_uptake_rate: (value: 1e-05, unit: "m2/h", source: "~ (1 cm/cm3 of roots gives 10% of available water per hour)"),
    root_uptake_max: (value: 3.0e-4, unit: "kg/m/h", source: "~ CERES RWUMX 0.03 cm3 water per cm of root per day, a daily ceiling, over the 10 hours that carry nearly all of a day's transpiration (a 14 to 15 h day with a sine-shaped demand: total over peak is about 9.5 h); was the same over 24 h, which held midday uptake to the 24 h mean (R2a, decision 0037, issue #116)"),
    stem_density: (value: 150000.0, unit: "g/m3", source: "~"),
    root_density: (value: 94000.0, unit: "g/m3", source: "OpenSimRoot bean root tissue density 0.094 g/cm3 (research review item 16)"),
    bulk_density: (value: 300000.0, unit: "g/m3", source: "~"),
    pod_aspect: (value: 7.5, unit: "-", source: "~ an ear about 9 cm by 1.2 cm"),
    seed_aspect: (value: 2.0, unit: "-", source: "~ a wheat grain about 6 by 3 mm"),
    phyllotaxis_angle: (value: 185.0, unit: "deg", source: "WALTer (Lecarpentier 2019): 185 deg between successive blades; grasses are distichous"),
  ),
  heritable: {            // phenotype parameters with bounds
    "vcmax25": (default: 110.0, min: 40.0, max: 200.0, unit: "umol/m2/s", source: "~ flag leaf 90 to 130 (research m2-m3 notes [K, to verify])"),
    "jmax25": (default: 190.0, min: 70.0, max: 320.0, unit: "umol/m2/s", source: "~ flag leaf 150 to 230 (research m2-m3 notes [K, to verify])"),
    "rd25": (default: 1.0, min: 0.3, max: 2.5, unit: "umol/m2/s", source: "~"),
    "medlyn_g1": (default: 5.8, min: 1.5, max: 8.0, unit: "kPa^0.5", source: "CLM5 PFT table (Lin et al. 2015): spring wheat 5.79, rounded (docs/research/retune/items-1-4.md item 4)"),
    "nodes_before_terminal": (default: 9.0, min: 5.0, max: 14.0, unit: "-", source: "~ final main-stem leaf number 8 to 9 in spring wheat (research m2-m3 notes [K, to verify])"),
    "habit": (default: 0.0, min: 0.0, max: 1.0, unit: "0 determinate / 1 indeterminate", source: "unused by the grass"),
    "bud_activation": (default: 0.6, min: 0.0, max: 1.0, unit: "-", source: "unused by the grass (grass.site_filling)"),
    "leaf_area_potential": (default: 30.0, min: 10.0, max: 60.0, unit: "cm2", source: "~ the largest blade: elong-Wheat widths of 13 to 14 mm at 25 to 30 cm long, by a 0.75 shape factor"),
    "specific_leaf_area": (default: 220.0, min: 120.0, max: 350.0, unit: "cm2/g", source: "~ total SLA 200 to 300 cm2/g (research m2-m3 notes [K, to verify])"),
    "internode_length_potential": (default: 18.0, min: 5.0, max: 40.0, unit: "cm", source: "~ the internode under the peduncle; plant height 0.7 to 1.0 m"),
    "specific_stem_length": (default: 100.0, min: 20.0, max: 300.0, unit: "cm/g", source: "~"),
    "leaf_lifespan": (default: 500.0, min: 200.0, max: 1000.0, unit: "Cd", source: "~ a tiller keeps about three live leaves (Berone 2008), the flag leaf lives into grain fill"),
    "root_elongation_scale": (default: 1.0, min: 0.5, max: 2.0, unit: "-", source: "~"),
    "seed_mass": (default: 0.045, min: 0.02, max: 0.07, unit: "g DM", source: "~ 1000-grain weight 35 to 50 g"),
    "seeds_per_pod": (default: 50.0, min: 20.0, max: 90.0, unit: "-", source: "~ florets per ear: about 18 spikelets of 2 to 3 fertile florets"),
    "flowers_per_raceme": (default: 1.0, min: 1.0, max: 12.0, unit: "-", source: "unused by the grass"),
  },
  genome: (               // M0: one locus per trait, zero variance (identity mapping)
    loci: [
      (trait: "vcmax25", effect: 1.0, dominance: 0.0, allele_sd: 0.0, source: Some("M0 identity mapping")),
      (trait: "jmax25", effect: 1.0, dominance: 0.0, allele_sd: 0.0, source: Some("M0 identity mapping")),
      (trait: "rd25", effect: 1.0, dominance: 0.0, allele_sd: 0.0, source: Some("M0 identity mapping")),
      (trait: "medlyn_g1", effect: 1.0, dominance: 0.0, allele_sd: 0.0, source: Some("M0 identity mapping")),
      (trait: "nodes_before_terminal", effect: 1.0, dominance: 0.0, allele_sd: 0.0, source: Some("M0 identity mapping")),
      (trait: "habit", effect: 1.0, dominance: 0.0, allele_sd: 0.0, source: Some("M0 identity mapping")),
      (trait: "bud_activation", effect: 1.0, dominance: 0.0, allele_sd: 0.0, source: Some("M0 identity mapping")),
      (trait: "leaf_area_potential", effect: 1.0, dominance: 0.0, allele_sd: 0.0, source: Some("M0 identity mapping")),
      (trait: "specific_leaf_area", effect: 1.0, dominance: 0.0, allele_sd: 0.0, source: Some("M0 identity mapping")),
      (trait: "internode_length_potential", effect: 1.0, dominance: 0.0, allele_sd: 0.0, source: Some("M0 identity mapping")),
      (trait: "specific_stem_length", effect: 1.0, dominance: 0.0, allele_sd: 0.0, source: Some("M0 identity mapping")),
      (trait: "leaf_lifespan", effect: 1.0, dominance: 0.0, allele_sd: 0.0, source: Some("M0 identity mapping")),
      (trait: "root_elongation_scale", effect: 1.0, dominance: 0.0, allele_sd: 0.0, source: Some("M0 identity mapping")),
      (trait: "seed_mass", effect: 1.0, dominance: 0.0, allele_sd: 0.0, source: Some("M0 identity mapping")),
      (trait: "seeds_per_pod", effect: 1.0, dominance: 0.0, allele_sd: 0.0, source: Some("M0 identity mapping")),
      (trait: "flowers_per_raceme", effect: 1.0, dominance: 0.0, allele_sd: 0.0, source: Some("M0 identity mapping")),
    ],
    mutation_rate: (value: 0.001, unit: "per locus per gamete", source: "design plan §3.12"),
  ),
  phenology: (
    t_base: (value: 0.0, unit: "C", source: "WALTer and APSIM-Wheat use base 0 C"),
    t_opt: (value: 26.0, unit: "C", source: "APSIM-Wheat [K, to verify] (research m2-m3 notes)"),
    t_opt_high: (value: 26.0, unit: "C", source: "equal to t_opt: APSIM-Wheat's single optimum (decision 0032)"),
    t_max: (value: 34.0, unit: "C", source: "APSIM-Wheat [K, to verify] (research m2-m3 notes)"),
    emergence: (value: 81.0, unit: "Cd", source: "WALTer: sowing to emergence 81 Cd (s.d. 30)"),
    flowering: (value: 900.0, unit: "Cd", source: "~ heading near 850 Cd for 9 leaves at an 85 Cd phyllochron, at least 760 at 15 h days (FAO X8234E), plus about 50 Cd to anthesis"),
    maturity: (value: 1700.0, unit: "Cd", source: "~ to verify against a named cultivar: anthesis plus about 800 Cd of grain filling; APSIM-Wheat spring types run about 1700 to 1900 Cd sowing to maturity (WP23 review)"),
  ),
  nitrogen: (             // WP24, decision 0020; protein fractions x 0.16 g N per g protein
    leaf_n_initial: (value: 0.045, unit: "g N / g DM", source: "~ green wheat leaves 4 to 5% N (CERES-Wheat [K, to verify])"),
    leaf_n_final: (value: 0.008, unit: "g N / g DM", source: "~ senesced wheat leaves under 1% N"),
    stem_n_initial: (value: 0.025, unit: "g N / g DM", source: "~"),
    stem_n_final: (value: 0.004, unit: "g N / g DM", source: "~ wheat straw about 0.4% N at harvest"),
    root_n_initial: (value: 0.02, unit: "g N / g DM", source: "~"),
    root_n_final: (value: 0.01, unit: "g N / g DM", source: "~"),
    shell_n_initial: (value: 0.02, unit: "g N / g DM", source: "~ ear chaff"),
    shell_n_final: (value: 0.005, unit: "g N / g DM", source: "~"),
    seed_n_initial: (value: 0.025, unit: "g N / g DM", source: "~ grain protein 9 to 14% at 5.7 g protein per g N"),
    seed_n_final: (value: 0.015, unit: "g N / g DM", source: "~"),
    nodule_n: (value: 0.048, unit: "g N / g DM", source: "CROPGRO-Drybean BNGRO048.SPE PRONOD 0.30 x 0.16"),
    leaf_n_area_base: (value: 0.3, unit: "g N / m2", source: "~ Kattge 2009 and Walker 2014 intercept, Vcmax25 = b (Na - 0.3) (research m2-m3 notes row 21, to verify)"),
    uptake_capacity: (value: 6.0e-4, unit: "g N / m / day", source: "~ CROPGRO-Drybean BNGRO048.SPE RTNO3 = RTNH4 (0.006 mg N per cm of root per day, each form) until a wheat value is read; applied to the sim's own root length in each cell, without the old 25x factor or reach (R2a, decision 0037)"),
    mobilization_rate: (value: 0.12, unit: "1/day", source: "CROPGRO-Drybean BNGRO048.SPE NMOBMX"),
    vegetative_mobilization: (value: 0.36, unit: "-", source: "CROPGRO-Drybean BNGRO048.SPE NVSMOB"),
    leaf_drop_mobile: (value: 0.1, unit: "-", source: "~ a leaf mined to within a tenth of its mobile nitrogen drops (CROPGRO drops at the final concentration)"),
    nodule_activity: (value: 0.0, unit: "g N / g DM / day", source: "wheat does not nodulate"),
    nodule_relative_growth: (value: 0.17, unit: "1/day", source: "CROPGRO-Drybean BNGRO048.SPE NODRGM"),
    nodule_initial_mass: (value: 0.014, unit: "g DM", source: "CROPGRO-Drybean BNGRO048.SPE DWNODI"),
    nodule_mass: (value: 0.002, unit: "g DM", source: "~ one organ stands for a cluster of a few nodules of 0.3 to 1 mg"),
    nodule_expansion: (value: 100.0, unit: "Cd", source: "~ nodules reach full size in about a week"),
    nodule_depth: (value: 30.0, unit: "cm", source: "~ most bean nodules sit in the top 20 to 30 cm; CROPGRO weights the top 50 cm"),
    fixation_cost: (value: 7.1, unit: "g C / g N", source: "CROPGRO-Drybean BNGRO048.SPE RFIXN 2.83 g CH2O per g protein / 0.16 x 0.4 (research m2-m3 notes, correction section)"),
    fixation_t_min: (value: 4.0, unit: "C", source: "CROPGRO-Drybean BNGRO048.SPE FNFXT"),
    fixation_t_opt_low: (value: 19.0, unit: "C", source: "CROPGRO-Drybean BNGRO048.SPE FNFXT"),
    fixation_t_opt_high: (value: 35.0, unit: "C", source: "CROPGRO-Drybean BNGRO048.SPE FNFXT"),
    fixation_t_max: (value: 44.0, unit: "C", source: "CROPGRO-Drybean BNGRO048.SPE FNFXT"),
    fixation_drought_threshold: (value: 0.85, unit: "-", source: "CROPGRO-Drybean BNGRO048.SPE FNFXD: full at TURFAC 0.85 or more"),
    nodule_nitrate_onset: (value: 5.0, unit: "mg N / kg", source: "~ research m2-m3 notes (to calibrate against 2 to 10 mM solution thresholds)"),
    nodule_nitrate_full: (value: 30.0, unit: "mg N / kg", source: "~ research m2-m3 notes"),
    nodule_nitrate_floor: (value: 0.1, unit: "-", source: "~ research m2-m3 notes"),
  ),
  climbing: (             // WP22; read only when habit >= 0.5 (the pole bean's values, unused by the grass)
    max_main_nodes: (value: 30.0, unit: "-", source: "~ research m2-m3 notes: open-ended, cap 25 to 35"),
    vegetative_after_flowering: (value: 260.0, unit: "Cd", source: "CROPGRO BNGRO048.ECO FL-VS 13 photothermal days (default and EMBRAPA ecotypes; 11 for others) x 20 Cd per day at optimum (t_opt - t_base)"),
    internode_ramp_nodes: (value: 8.0, unit: "-", source: "~ CROPGRO YVSHT reaches full length by about node 10 (research m2-m3 notes)"),
    circumnutation_radius: (value: 6.0, unit: "cm", source: "~ 3 to 10 cm (Sothern 1998 for Glycine soja, 2.9 to 8.7 cm; research m2-m3 notes)"),
    circumnutation_growth: (value: 0.25, unit: "-", source: "~ the circumnutating tip is the free stem above the last hold, and its swing widens as that free length grows (Darwin 1875 describes revolving shoots sweeping wider circles as they lengthen); 0.25 is a lean of about 15 degrees from the vertical, to validate (decision 0029)"),
    circumnutation_radius_max: (value: 15.0, unit: "cm", source: "~ a cap so a long free tip (it lodges at self_support_length) does not reach a stake across a row; to validate against measured bean circumnutation amplitudes (decision 0029)"),
    support_diameter_sure: (value: 5.0, unit: "cm", source: "Darwin 1875; research m2-m3 notes: certain capture up to 5 cm"),
    support_diameter_max: (value: 20.0, unit: "cm", source: "Darwin 1875 (fails on 23 cm); research m2-m3 notes: capture falls to 0 at 10 to 20 cm"),
    helix_pitch: (value: 14.0, unit: "cm", source: "~ the pole bean's value (decision 0029)"),
    helix_inclination_min: (value: 35.0, unit: "deg", source: "Rutjens 2025: 35 to 75 deg"),
    helix_inclination_max: (value: 75.0, unit: "deg", source: "Rutjens 2025: 35 to 75 deg"),
    self_support_length: (value: 40.0, unit: "cm", source: "~"),
    heap_radius: (value: 15.0, unit: "cm", source: "~ a fallen vine coils back on itself"),
    lodge_height: (value: 2.0, unit: "cm", source: "~ a fallen stem lies on the soil"),
