// Seed-coat and flower colour of common bean (WP28, decision 0023 item 6; decision 0029).
// A gated pipeline evaluated layer by layer; in each layer the first matching rule applies.
// Allele state codes rise with dominance and match the named loci of bush_bean.ron and
// pole_bean.ron: P 0 p, 1 p^gri, 2 P | T 0 t, 1 T | C 0 c, 1 C^mot, 2 C, 3 C^R |
// J 0 j, 1 J | G 0 g, 1 G | B 0 b, 1 B | V 0 v, 1 v^lae, 2 V | Rk 0 rk, 1 Rk |
// Z 0 z, 1 z^sel, 2 Z | Bip 0 bip, 1 bip^ana, 2 Bip | Asp 0 asp, 1 Asp.
// Source: docs/research/m3-breeding-and-weeds/notes/genetics_map_colour.md §3 (H = hue rows,
// C = pattern rows). Colours are hints from the Munsell/ISCC-NBS names [I]; "~" marks a
// rule or value to validate against photos.
(
  species: ["bush_bean", "pole_bean"],
  source: "WP28 research §3, from McClean and Bassett 2002, Beninger, Hosfield and Bassett 2000, the Bassett and McClean partly coloured review, Hosfield (citing Bassett 1998c, 1999) and Parker 2024",
  default: (seed_coat: "#6E4E37", ground: "#F4F1E8", pattern: "self", coverage: 1.0, glossy: true, flower: "#F4F1E8"),
  layers: [
    (name: "P gate", rules: [
      (when: [Expressed(locus: "P", state: 0)],
       set: (seed_coat: Some("#F4F1E8"), ground: Some("#F4F1E8"), flower: Some("#F4F1E8")), stop: true,
       source: "H1: pp white seed and white flower, epistatic to every colour locus (McClean 2002, 2018; Beninger 2000)"),
      (when: [Expressed(locus: "P", state: 1)],
       set: (seed_coat: Some("#DAD6CC"), ground: Some("#DAD6CC"), flower: Some("#EFEDF2")), stop: true,
       source: "H2: p^gri grey-white seed, flower nearly white (McClean 2002)"),
    ]),
    (name: "flower", rules: [
      (when: [Homozygous(locus: "T", state: 0)], set: (flower: Some("#F4F1E8")),
       source: "tt gives white flowers whatever V carries (Bassett and McClean review; McClean 2023)"),
      (when: [Expressed(locus: "V", state: 2)], set: (flower: Some("#8A4FB5")),
       source: "V purple flower (McClean 2002)"),
      (when: [Expressed(locus: "V", state: 1)], set: (flower: Some("#D99BB8")),
       source: "v^lae pink flower (McClean 2002)"),
      (when: [], set: (flower: Some("#F4F1E8")), source: "vv white flower (McClean 2002)"),
    ]),
    (name: "hue", rules: [
      (when: [Expressed(locus: "C", state: 3)], set: (seed_coat: Some("#8E2A23")),
       source: "H12: dominant R in the C complex gives red (Beninger 2000); small red class link [K, to verify]"),
      (when: [Homozygous(locus: "C", state: 0)], set: (seed_coat: Some("#E3CFA4")),
       source: "C2: cc cartridge buff (McClean 2002: 3 grey brown : 1 cartridge buff)"),
      (when: [Homozygous(locus: "J", state: 0), Carries(locus: "G", state: 1)], set: (seed_coat: Some("#E8D58A")),
       source: "H13: j G, light yellow (Prim, Manteca; Beninger 2000; Hosfield)"),
      (when: [Homozygous(locus: "J", state: 0)], set: (seed_coat: Some("#EDE3B5")),
       source: "~ H14: j gives paler, 'immature' colours (Beninger 2000); the jj gg hue is [I]"),
      (when: [Expressed(locus: "V", state: 2), Carries(locus: "B", state: 1)], set: (seed_coat: Some("#1A1416")),
       source: "H3: P C J B V black (Beninger 2000)"),
      (when: [Expressed(locus: "V", state: 2)], set: (seed_coat: Some("#3F2630")),
       source: "H5: P C J G b V dark brown violet (Beninger 2000)"),
      (when: [Homozygous(locus: "Rk", state: 0), Homozygous(locus: "G", state: 0)], set: (seed_coat: Some("#6B1A1F")),
       source: "H10: J g B v rk dark red kidney (Hosfield citing Bassett 1998c; Beninger 2000); rk^d not separated [I]"),
      (when: [Homozygous(locus: "Rk", state: 0)], set: (seed_coat: Some("#A4413C")),
       source: "~ H11: light red kidney [K, to verify]"),
      (when: [Carries(locus: "G", state: 1), Carries(locus: "B", state: 1)], set: (seed_coat: Some("#4A3020")),
       source: "H6: P C J G B v dark brown (Hosfield)"),
      (when: [Carries(locus: "G", state: 1)], set: (seed_coat: Some("#A5773A")),
       source: "H7: P C J G b v yellow brown (Hosfield; Beninger 2000)"),
      (when: [Carries(locus: "B", state: 1)], set: (seed_coat: Some("#D9C08A")),
       source: "H8: gg chamois (McClean 2002); the B split is [I]"),
      (when: [], set: (seed_coat: Some("#B9A35A")),
       source: "H8, H9: vv bb gg buffy citrine (McClean 2002; two-gene reading [I])"),
    ]),
    (name: "pattern", rules: [
      (when: [Carries(locus: "T", state: 1), Expressed(locus: "C", state: 1)],
       set: (pattern: Some("mottled"), ground: Some("#D8B98C"), coverage: Some(0.5)),
       source: "~ C3: a mottling C-complex allele on a buff ground, as in pinto [K, to verify]; coverage [I]"),
      (when: [Carries(locus: "T", state: 1)], set: (pattern: Some("self"), coverage: Some(1.0)),
       source: "C1: T_ with a self C allele is solid colour (McClean 2002)"),
    ]),
    (name: "partly coloured", rules: [
      (when: [Homozygous(locus: "T", state: 0), Homozygous(locus: "J", state: 0), Homozygous(locus: "Z", state: 0)],
       set: (pattern: Some("white"), coverage: Some(0.0)),
       source: "t z j white (Bassett and McClean review)"),
      (when: [Homozygous(locus: "T", state: 0), Homozygous(locus: "J", state: 0)],
       set: (pattern: Some("marginata"), coverage: Some(0.5)),
       source: "t Z j marginata (Bassett and McClean review); coverage [I]"),
      (when: [Homozygous(locus: "T", state: 0), Carries(locus: "Z", state: 2), Carries(locus: "Z", state: 0), Expressed(locus: "Bip", state: 2)],
       set: (pattern: Some("ambigua"), coverage: Some(0.6)),
       source: "t Z/z Bip ambigua, unstable (Bassett and McClean review); coverage ~ [I]"),
      (when: [Homozygous(locus: "T", state: 0), Expressed(locus: "Z", state: 2), Expressed(locus: "Bip", state: 2)],
       set: (pattern: Some("self"), coverage: Some(1.0)),
       source: "t Z Bip fib full colour (McClean 2023 bioRxiv); Fib is not modelled"),
      (when: [Homozygous(locus: "T", state: 0), Expressed(locus: "Z", state: 2), Expressed(locus: "Bip", state: 1)],
       set: (pattern: Some("anasazi"), coverage: Some(0.25)),
       source: "t Z bip^ana anasazi (Bassett and McClean review); coverage [I]"),
      (when: [Homozygous(locus: "T", state: 0), Homozygous(locus: "Z", state: 1), Expressed(locus: "Bip", state: 2)],
       set: (pattern: Some("sellatus"), coverage: Some(0.3)),
       source: "t z^sel Bip sellatus (Bassett and McClean review); coverage [I]"),
      (when: [Homozygous(locus: "T", state: 0), Expressed(locus: "Z", state: 1), Expressed(locus: "Bip", state: 2)],
       set: (pattern: Some("piebald"), coverage: Some(0.3)),
       source: "t z^sel/z Bip piebald (Bassett and McClean review); coverage ~ [I]"),
      (when: [Homozygous(locus: "T", state: 0), Homozygous(locus: "Z", state: 0), Expressed(locus: "Bip", state: 2)],
       set: (pattern: Some("virgarcus"), coverage: Some(0.35)),
       source: "t z Bip virgarcus, dorsal colour (McClean 2023 bioRxiv); coverage [I]"),
      (when: [Homozygous(locus: "T", state: 0), Homozygous(locus: "Z", state: 0), Expressed(locus: "Bip", state: 1)],
       set: (pattern: Some("anabip"), coverage: Some(0.2)),
       source: "t z bip^ana anabip (Bassett and McClean review); coverage ~ [I]"),
      (when: [Homozygous(locus: "T", state: 0), Homozygous(locus: "Z", state: 0), Homozygous(locus: "Bip", state: 0)],
       set: (pattern: Some("bipunctata"), coverage: Some(0.1)),
       source: "t z bip bipunctata, two spots by the hilum (McClean 2023 bioRxiv); coverage [I]"),
      (when: [Homozygous(locus: "T", state: 0)],
       set: (pattern: Some("partly coloured"), coverage: Some(0.5)),
       source: "~ tt combinations the review does not list (e.g. Z bip, z^sel bip^ana) [I]"),
    ]),
    (name: "shine", rules: [
      (when: [Homozygous(locus: "Asp", state: 0)], set: (glossy: Some(false)),
       source: "asp asp dull, matte coat (Beninger 2000)"),
      (when: [], set: (glossy: Some(true)), source: "Asp_ glossy (Beninger 2000)"),
    ]),
  ],
)
